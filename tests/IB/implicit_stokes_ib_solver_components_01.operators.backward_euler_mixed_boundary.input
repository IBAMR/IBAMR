test_case = "operators"
time_stepping = "BACKWARD_EULER"
physical_boundary = TRUE
// Periodic in x and bounded by walls in y: the ring lies next to the lower wall and crosses the periodic seam, so
// its stencils meet both, and the walls carry a tangential velocity.
structure_center = 0.03, 0.15
structure_radii = 0.02, 0.1
wall_velocity_faces = 2, 3
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}
IBMethod { delta_fcn = "IB_4" }
IBRedundantInitializer {
   max_levels = 1
   base_filenames_0 = "curve"
}
CartesianGeometry {
   domain_boxes = [(0,0),(15,15)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 0
}
GriddingAlgorithm {
   max_levels = 1
   largest_patch_size { level_0 = 16, 16 }
   smallest_patch_size { level_0 = 16, 16 }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes { level_0 = [(0,0),(15,15)] }
}
LoadBalancer { bin_pack_method = "SPATIAL" }
