test_case = "foundation"
CAV_APPLICATION_ONLY = FALSE
VERIFY_FGMRES_PHYSICAL_RESIDUALS = TRUE
// Walls prescribe the velocity on every side, with a unit tangential velocity on the top wall, and the structure lies
// next to that wall. The preconditioned solve took 9 iterations on the reference environment; the bound below is
// intentionally looser (not printed or baselined) since the exact count is sensitive to the BLAS/LAPACK and compiler
// environment, not just the smoother quality.
MAX_KRYLOV_ITERATIONS = 14
N = 4
MAX_LEVELS = 2
MU = 0.01
RHO = 1.0
DT = 0.005
DS = 1.0/8.0
SPRING_STIFFNESS = 200
Y_CENTER = 0.7
IB_TIME_STEPPING = "BACKWARD_EULER"
TAG_BUFFER = 2
stokes_ib_precond_db {
   num_pre_sweeps = 1
   num_post_sweeps = 1
   U_prolongation_method = "RT0_REFINE"
   U_restriction_method = "RT0_COARSEN"
   rediscretize_stokes = TRUE
   res_rediscretized_stokes = TRUE
   level_solver_type = "PETSC_LEVEL_SOLVER"
   level_solver_max_iterations = 1
   level_solver_db {
      initial_guess_nonzero = FALSE
      ksp_type = "preonly"
      pc_type = "shell"
      subdomain_construction = "COUPLING_AWARE"
      subdomain_relaxation {
         composition = "MULTIPLICATIVE"
         grouping = "RANK"
         output = "FULL"
         traversal = "SYMMETRIC"
      }
   }
   coarse_solver_type = "PETSC_LEVEL_SOLVER"
   coarse_solver_max_iterations = 1
   coarse_solver_db {
      ksp_type = "preonly"
      pc_type = "svd"
      initial_guess_nonzero = FALSE
   }
}
VelocityInitialConditions {
   function_0 = "X_1"
   function_1 = "0.0"
}
VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "1.0"
}
VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}
IBMethod { delta_fcn = "IB_4" }
IBRedundantInitializer {
   max_levels = MAX_LEVELS
   base_filenames_0 = "curve"
   base_filenames_1 = "curve"
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   petsc_settings {
      stokes_ib_pc_level_1_sub_pc_type = "svd"
      ib_ksp_type = "fgmres"
      ib_ksp_rtol = "1e-11"
      ib_ksp_atol = "1e-13"
      ib_ksp_max_it = "200"
      ib_ksp_gmres_restart = "100"
   }
}
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 0, 0
}
GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = N * 1, N * 1
      level_1 = N * 2, N * 2
   }
   smallest_patch_size {
      level_0 = N * 1, N * 1
      level_1 = N * 2, N * 2
   }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0, 0), (N * 1 - 1, N * 1 - 1)]
   }
}
LoadBalancer { bin_pack_method = "SPATIAL" }
