setup_test = "wide_kernel"
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}
IBMethod {
   delta_fcn = "IB_4"
   min_ghost_cell_width = 4
}
IBRedundantInitializer {
   max_levels = 1
   base_filenames_0 = "probes"
}
CartesianGeometry {
   domain_boxes = [(0,0),(3,3)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 1
}
GriddingAlgorithm {
   max_levels = 1
   largest_patch_size { level_0 = 4, 4 }
   smallest_patch_size { level_0 = 4, 4 }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes { level_0 = [(0,0),(3,3)] }
}
LoadBalancer { bin_pack_method = "SPATIAL" }
