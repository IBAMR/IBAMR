// The integrator constructor rejects a jacobian_delta_fcn that is not a valid
// kernel name.
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}
IBMethod {
}
INSStaggeredHierarchyIntegrator {
   mu = 1.0
   rho = 1.0
   start_time = 0.0
   end_time = 1.0
}
IBImplicitStaggeredHierarchyIntegrator {
   jacobian_delta_fcn = "BAD NAME"
}
