// A registration on one integrator must not resolve the same kernel name on
// another integrator: registrations do not leak across integrators.
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}
IBMethod {
}
INSStaggeredHierarchyIntegrator {
   mu = 1.0
   rho = 1.0
   start_time = 0.0
   end_time = 1.0
}
