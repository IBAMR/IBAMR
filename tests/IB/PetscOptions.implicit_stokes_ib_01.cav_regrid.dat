# End-to-end pressure-seeded multiplicative CAV solve.
-ib_ksp_type fgmres
-ib_ksp_rtol 1.0e-10
-ib_ksp_atol 1.0e-50
-ib_ksp_max_it 100
-ib_ksp_gmres_restart 100

-stokes_ib_pc_level_ksp_type preonly
-stokes_ib_pc_level_pc_type shell

-stokes_ib_pc_level_0_ksp_type preonly
-stokes_ib_pc_level_0_pc_type svd
