// The case of interpolation_spreading_adjoint_2d.traction with the variable-coefficient fluid solver and constant
// density and viscosity: TRACTION conditions on the lower boundaries, walls on the upper boundaries. The inner products
// equal those of that case.
N = 16
MAX_LEVELS = 1
marker_displacement = 0.0   // in grid cells along each axis, toward the center of the domain

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time     = 0.0
   end_time       = 0.01
   dt_max         = 0.01
   enable_logging = FALSE
}

IBMethod {
   delta_fcn      = "IB_4"
   enable_logging = FALSE
}

IBRedundantInitializer {
   max_levels       = MAX_LEVELS
   base_filenames_0 = "markers"
}

INSVCStaggeredNonConservativeHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   mu_is_const             = TRUE
   rho_is_const            = FALSE
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
   velocity_solver_type    = "VC_VELOCITY_PETSC_KRYLOV_SOLVER"
   velocity_precond_type   = "VC_VELOCITY_POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_precond_db {
      coarse_solver_type = "VC_VELOCITY_PETSC_LEVEL_SOLVER"
   }
}

DensityFunction {
   function = "1.0"
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 4,4
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
