// Walls on all boundaries, a kernel with an odd stencil size, and patches that are exactly as wide as the ghost cell
// width, with the markers displaced by 0.9 grid cells.
N = 18
MAX_LEVELS = 1
marker_displacement = 0.9   // markers lie outside the patches that hold them

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time     = 0.0
   end_time       = 0.01
   dt_max         = 0.01
   enable_logging = FALSE
}

IBMethod {
   delta_fcn      = "COMPOSITE_BSPLINE_54"
   enable_logging = FALSE
}

IBRedundantInitializer {
   max_levels       = MAX_LEVELS
   base_filenames_0 = "markers"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   allow_patches_smaller_than_ghostwidth = TRUE
   largest_patch_size {
      level_0 = 3,3
   }
   smallest_patch_size {
      level_0 = 3,3
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
