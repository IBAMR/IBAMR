// As vc_traction_velocity_bc_2d.traction_viscosity_field, but a regrid after the checks changes the fine level. The
// velocity ghost fill on the new patches, which have no viscosity data, uses the nonzero traction data and stops with
// an error.

N = 16

// The ghost cells of the velocity are wider than those of the viscosity.
ghost_width = 6

// Regrid at the time 1.0. The input specifies the second set of refine boxes for that time.
regrid_after_initialization = TRUE

ExactVelocity {
   error_bound = 1.0e-1
   function_0 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
   function_1 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
   gcoef_function_3 = "-0.7*sin(1.1*X_0+0.3)*sin(0.7*X_1)+2*X_1+0.5-0.9*sin(0.9*X_0)*sin(1.3*X_1+0.2)+X_1"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "-0.7*sin(1.1*X_0+0.3)*sin(0.7*X_1)+2*X_1+0.5-0.9*sin(0.9*X_0)*sin(1.3*X_1+0.2)+X_1"
   gcoef_function_1 = "-0.7*sin(1.1*X_0+0.3)*sin(0.7*X_1)+2*X_1+0.5-0.9*sin(0.9*X_0)*sin(1.3*X_1+0.2)+X_1"
   gcoef_function_2 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
   gcoef_function_3 = "0.0"
}

DensityFunction {
   function = "1.0 + 0.5*X_0*X_1"
}

ViscosityFunction {
   function = "1.0"
}

ViscosityBoundaryConditions {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "1.0"
   gcoef_function_1 = "1.0"
   gcoef_function_2 = "1.0"
   gcoef_function_3 = "1.0"
}

INSVCStaggeredNonConservativeHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   mu_is_const             = FALSE
   rho_is_const            = FALSE
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
   velocity_solver_type    = "VC_VELOCITY_PETSC_KRYLOV_SOLVER"
   velocity_precond_type   = "VC_VELOCITY_POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_precond_db {
      coarse_solver_type = "VC_VELOCITY_PETSC_LEVEL_SOLVER"
   }
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2,2
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 {
         times   = 0.0, 0.5
         boxes_0 = [ (0,4),(N - 1,11) ]
         boxes_1 = [ (0,2),(N - 1,13) ]
      }
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
