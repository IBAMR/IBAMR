// Steady Stokes flow with drag in a periodic box, for a fluid of zero density and variable viscosity.

// physical parameters
L      = 1.0
RHO    = 0.0                      // constant density, exactly zero
MU0    = 0.1
LAMBDA = 1.0                      // drag coefficient

// grid and time stepping parameters
N        = 16
DT       = 0.01
END_TIME = 2*DT

// exact solution function expressions
U   = "0.5*sin(2*PI*X_1)"
V   = "0.0"
P   = "sin(2*PI*X_0)"
F_U = "0.5*lambda*sin(2*PI*X_1) - mu0*PI^2*(cos(2*PI*X_1)^2 - 2*sin(2*PI*X_1) - sin(2*PI*X_1)^2) + 2*PI*cos(2*PI*X_0)"
MU  = "mu0*(1.0 + 0.5*sin(2*PI*X_1))"

DensityFunction {
   function = "rho"
   rho = RHO
}

ViscosityFunction {
   function = MU
   mu0 = MU0
}

VelocityInitialConditions {
   function_0 = U
   function_1 = V
}

PressureInitialConditions {
   function = P
}

ForcingFunction {
   function_0 = F_U
   function_1 = "0.0"
   mu0 = MU0
   lambda = LAMBDA
}

INSVCStaggeredNonConservativeHierarchyIntegrator {
   end_time                   = END_TIME
   dt_max                     = DT
   viscous_time_stepping_type = "BACKWARD_EULER"
   normalize_pressure         = TRUE
   creeping_flow              = TRUE
   rho_is_const               = TRUE
   rho                        = RHO
   mu_is_const                = FALSE
   lambda                     = LAMBDA

   velocity_solver_type  = "VC_VELOCITY_PETSC_KRYLOV_SOLVER"
   velocity_precond_type = "VC_VELOCITY_POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_solver_db {
      ksp_type       = "richardson"
      max_iterations = 5
   }
   velocity_precond_db {
      num_pre_sweeps     = 0
      num_post_sweeps    = 3
      coarse_solver_type = "VC_VELOCITY_PETSC_LEVEL_SOLVER"
      coarse_solver_db {
         ksp_type = "gmres"
         pc_type  = "jacobi"
      }
   }

   stokes_solver_type = "VC_STAGGERED_STOKES_PETSC_KRYLOV_SOLVER"
   stokes_solver_db {
      ksp_type         = "fgmres"
      rel_residual_tol = 1.0e-10   // converge to the discrete solution
      max_iterations   = 100       // bounds the run when the solver cannot converge
   }
}

Main {
   log_file_name = "INS2d.log"
}

CartesianGeometry {
   domain_boxes       = [ (0,0),(N - 1,N - 1) ]
   x_lo               = 0,0
   x_up               = L,L
   periodic_dimension = 1,1
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 512,512
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
   }
}

LoadBalancer {
}
