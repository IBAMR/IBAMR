// TRACTION type conditions that prescribe the velocity everywhere except on the end face of the upper boundary
// (X_0 > 0.995 on the face x = 1). The x-velocity has a traction condition on that face. The boundary data depend on
// the velocity there. The accumulation of the ghost values is therefore not the transpose of the fill and stops with an
// error.

check_transpose = TRUE

N = 16

ExactVelocity {
   error_bound = 5.0e-2
   function_0 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
   function_1 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "(X_0 > 0.995) ? 0.0 : 1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "(X_0 > 0.995) ? 1.0 : 0.0"

   gcoef_function_0 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
   gcoef_function_1 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
   gcoef_function_2 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
   gcoef_function_3 = "sin(1.1*X_0+0.3)*cos(0.7*X_1)+X_1*X_1+0.5*X_1"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
   gcoef_function_1 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
   gcoef_function_2 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
   gcoef_function_3 = "cos(0.9*X_0)*sin(1.3*X_1+0.2)+X_0*X_1"
}

DensityFunction {
   function = "1.0 + 0.5*X_0*X_1"
}

INSVCStaggeredNonConservativeHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   mu_is_const             = TRUE
   rho_is_const            = FALSE
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
   velocity_solver_type    = "VC_VELOCITY_PETSC_KRYLOV_SOLVER"
   velocity_precond_type   = "VC_VELOCITY_POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_precond_db {
      coarse_solver_type = "VC_VELOCITY_PETSC_LEVEL_SOLVER"
   }
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
