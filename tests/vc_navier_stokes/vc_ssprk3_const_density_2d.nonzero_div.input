// Nonzero-divergence advection velocity triggers fallback to full SSPRK3 integration.

dt = 0.002
expected_fast_path_hits = 0
expected_fallback_count = 1

rho_init {
   function = "1.25"
}

u_init {
   function_0 = "(1.0 + 50.0*t)*(0.8 + 2.0*(X_0 - 0.5))"
   function_1 = "0.0"
}

VelocityBcCoefs_0 {
   u0 = "(1.0 + 50.0*t)*(0.8 + 2.0*(X_0 - 0.5))"
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = u0
   gcoef_function_1 = u0
   gcoef_function_2 = u0
   gcoef_function_3 = u0
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

DensityBcCoefs {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "1.25"
   gcoef_function_1 = "1.25"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

fast_integrator_db {
   density_time_stepping_type          = "SSPRK3"
   velocity_convective_limiter         = "CUI"
   density_convective_limiter          = "CUI"
   velocity_bdry_extrap_type           = "LINEAR"
   density_bdry_extrap_type            = "CONSTANT"
   skip_constant_density_ssprk_stages  = TRUE
   constant_density_max_stage_div_dt   = 1.0e-6
   enable_logging                      = FALSE
}

ref_integrator_db {
   density_time_stepping_type          = "SSPRK3"
   velocity_convective_limiter         = "CUI"
   density_convective_limiter          = "CUI"
   velocity_bdry_extrap_type           = "LINEAR"
   density_bdry_extrap_type            = "CONSTANT"
   skip_constant_density_ssprk_stages  = FALSE
   enable_logging                      = FALSE
}

Main {
   log_file_name = "vc_ssprk3_const_density.log"
   log_all_nodes = FALSE
}

N = 16

CartesianGeometry {
   domain_boxes       = [(0, 0), (N - 1, N - 1)]
   x_lo               = 0.0, 0.0
   x_up               = 1.0, 1.0
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = 8, 8
   }
   smallest_patch_size {
      level_0 = 4, 4
   }
   efficiency_tolerance = 0.80e0
   combine_efficiency   = 0.80e0
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(N/4, N/4), (3*N/4 - 1, 3*N/4 - 1)]
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
