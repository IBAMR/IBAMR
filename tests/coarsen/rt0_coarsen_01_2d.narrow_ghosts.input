// The coarsened data have one ghost cell, fewer than other data on the hierarchy; several fine patches touch each
// boundary.
u_ghost_width = 1

u {
   function_0 = "42.0 + 2*X_0 + 1"
   function_1 = "42.0 + 3.0 - 3*X_1"
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}

N = 4

CartesianGeometry {
   domain_boxes = [(0,0), (N - 1,N - 1)]
   x_lo = 0, 0
   x_up = 1, 1
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = 2

   ratio_to_coarser {
      level_1 = 2, 2
   }

   largest_patch_size {
      level_0 = N, N
   }

   smallest_patch_size {
      level_0 = N, N
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0, 0), (N - 1, N - 1)]
   }
}

LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
