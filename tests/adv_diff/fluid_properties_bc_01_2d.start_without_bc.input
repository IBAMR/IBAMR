// Constant level set; the first fill has no boundary condition object, and B makes the density at the boundary gas
START_WITHOUT_BC    = TRUE
RHO_LIQUID          = 1000.0
RHO_GAS             = 1.0
MU_LIQUID           = 1.0
MU_GAS              = 1.0
NUM_INTERFACE_CELLS = 1.0

N = 16

LevelSetInitialCondition {
   function = "1.0"
}

LevelSetBcCoefsA {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "1.0"
   gcoef_function_1 = "1.0"
   gcoef_function_2 = "1.0"
   gcoef_function_3 = "1.0"
}

LevelSetBcCoefsB {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "-1.0"
   gcoef_function_1 = "-1.0"
   gcoef_function_2 = "-1.0"
   gcoef_function_3 = "-1.0"
}

AdvectionVelocityFunction {
   function_0 = "0.0"
   function_1 = "0.0"
}

AdvDiffSemiImplicitHierarchyIntegrator {
   start_time                    = 0.0
   end_time                      = 1.0
   grow_dt                       = 2.0
   num_cycles                    = 1
   convective_time_stepping_type = "ADAMS_BASHFORTH"
   convective_op_type            = "PPM"
   convective_difference_form    = "ADVECTIVE"
   cfl                           = 0.25
   dt_max                        = 0.01
   tag_buffer                    = 1
   regrid_interval               = 10000000
   enable_logging                = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
   efficiency_tolerance = 0.85e0
   combine_efficiency   = 0.85e0
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [( N/4,N/4 ),( 3*N/4 - 1,3*N/4 - 1 )]
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
