// Layout independence of IMPMethod on the domain [0.1, 1.1) x [0.1, 1.1) that is periodic in x, with TRACTION conditions
// on the lower y boundary and a wall on the upper y boundary. The two patches of 16 x 32 cells meet at x = 0.6, and the
// periodic seam is at x = 0.1, where the designed positions are on and within a few ulps of the seam. Points beyond the
// seam are reached through their periodic images. See traction_seam_2d.layouts.input for the points and the comparison.
N = 32
MAX_LEVELS = 1
layouts = "one_patch", "two_halves"
strip = 0.2, 1.0, 0.2, 0.5
num_elements_x = 12
num_elements_y = 6

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time     = 0.0
   end_time       = 0.01
   dt_max         = 0.01
   enable_logging = FALSE
}

IMPMethod {
}

IMPInitializer {
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0.1,0.1
   x_up = 1.1,1.1
   periodic_dimension = 1,0
}

GriddingAlgorithm_one_patch {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 32,32
   }
   smallest_patch_size {
      level_0 = 32,32
   }
}

GriddingAlgorithm_two_halves {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 16,32
   }
   smallest_patch_size {
      level_0 = 16,32
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
