// Scalar parameters

LAMBDA = 1.0
MU = 1.0
RHO = 1.0
GAMMA = 1.0
ZETA = 1.0
acoustic_angular_freq = 1.0
sound_speed = 1.0

N = 64
PERIODIC_BC = 0

CHIA = "sin(2*PI*X0)"
CHIE = "1.0 - sin(2*PI*X0)"

u {

   function_0 = "cos(2*PI*X1)*sin(2*PI*X0)"      // ur x-component
   function_1 = "sin(2*PI*X0)*sin(2*PI*X1)"      // vr y-component

   function_2 = "2*cos(2*PI*X1)*sin(2*PI*X0)"     // ui x-component
   function_3 = "2*sin(2*PI*X0)*sin(2*PI*X1)"   // vi y-component
}

p {

   function_0 = "sin(2*PI*X0)*sin(2*PI*X1)"    // pr
   function_1 = "2*sin(2*PI*X0)*sin(2*PI*X1)"      // pi

}

fu {

   function_0 = "cos(2*PI*X1)*(6*PI^2 + sin(2*PI*X0) - 2*PI^2*(-4*cos(2*PI*X0) + 21*cos(4*PI*X0) + 8*sin(2*PI*X0) + 9*sin(4*PI*X0))) + 4*PI*sin(4*PI*X0)*sin(2*PI*X1)"       // fur x-component

   function_1 = "4*PI*cos(2*PI*X1)*sin(2*PI*X0)^2 + (18*PI^2 + sin(2*PI*X0) - 2*PI^2*(4*cos(2*PI*X0) + 15*cos(4*PI*X0) + 8*sin(2*PI*X0) - 9*sin(4*PI*X0)))*sin(2*PI*X1)"     // fvr y-component

   function_2 = "-2*cos(2*PI*X1)*(PI^2 + sin(2*PI*X0) - PI^2*(-8*cos(2*PI*X0) + 7*cos(4*PI*X0) + 16*sin(2*PI*X0) + 3*sin(4*PI*X0))) + 2*PI*sin(4*PI*X0)*sin(2*PI*X1)"        // fui x-component

   function_3 = "2*(PI*cos(2*PI*X1)*sin(2*PI*X0)^2 + (-3*PI^2 - sin(2*PI*X0) + PI^2*(8*cos(2*PI*X0) + 5*cos(4*PI*X0) + 16*sin(2*PI*X0) - 3*sin(4*PI*X0)))*sin(2*PI*X1))"     // fvi y-component
}

fp  {

   function_0 = "sin(2*PI*X0)*(4*PI*cos(2*PI*X1)*(cos(2*PI*X0) + sin(2*PI*X0)) + sin(2*PI*X1))"    // fpr
   function_1 =  "2*sin(2*PI*X0)*(PI*cos(2*PI*X1)*(cos(2*PI*X0) + sin(2*PI*X0)) - sin(2*PI*X1))"    // fpi
}

mu {
   c = MU
   function = "c"
}

lambda {
   c = LAMBDA
   function = "c"
}

rho {

   c = RHO
   function = "c"
}

gamma {
   c = GAMMA
   function = "c"
}

zeta {
   c = ZETA
   function = "c"
}

chi_a {
   function = CHIA
}

chi_e {
   function = CHIE
}

// ur velocity
VelocityRealBcCoefs_0 {


   u_fcn = "cos(2*PI*X1)*sin(2*PI*X0)"


   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = u_fcn
   gcoef_function_1 = u_fcn
   gcoef_function_2 = u_fcn
   gcoef_function_3 = u_fcn

}

// vr velocity
