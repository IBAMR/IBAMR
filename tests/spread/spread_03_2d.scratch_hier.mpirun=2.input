// Uniform Lagrangian fluid source spread through a multi-patch scratch
// hierarchy onto a coarser primary patch layout on two MPI processes.

L = 1.0
MAX_LEVELS = 1
N = 32
DX = L/N
MFAC = 2.0
ELEM_TYPE = "TRI3"
STRUCTURE_LOWER = 0.3
STRUCTURE_UPPER = 0.7
SOURCE_STRENGTH = 1.5
IB_DELTA_FUNCTION = "IB_4"

IBHierarchyIntegrator {}
IBFEMethod {
   IB_delta_fcn               = IB_DELTA_FUNCTION
   enable_logging             = TRUE
   skip_initial_workload_log  = TRUE
   workload_quad_point_weight = 1.0
   use_scratch_hierarchy      = TRUE

   GriddingAlgorithm {
      max_levels = MAX_LEVELS
      largest_patch_size {
         level_0 = 8,8
      }
      smallest_patch_size {
         level_0 = 8,8
      }
      efficiency_tolerance = 0.1e0
      combine_efficiency   = 0.1e0
      coalesce_boxes       = TRUE
   }

   LoadBalancer {
      type                = "DEFAULT"
      bin_pack_method     = "SPATIAL"
      max_workload_factor = 0.0625
   }
}

INSStaggeredHierarchyIntegrator {
   mu  = 1
   rho = 1
}

Main {
   solver_type   = "STAGGERED"
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = L,L
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 32,32
   }
   smallest_patch_size {
      level_0 = 8,8
   }
}

StandardTagAndInitialize {tagging_method = "GRADIENT_DETECTOR"}
LoadBalancer {}
