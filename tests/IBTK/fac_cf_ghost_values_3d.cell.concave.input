// Three fine patches in an L shape with a reentrant edge.
N = 10
REF_RATIO = 2
CENTERING = "CELL"
FINE_BOXES = [(6,6,6),(9,9,9)], [(10,6,6),(13,9,9)], [(10,10,6),(13,13,9)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 0,0,0
   x_up               = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512,512
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0,0),(N - 1,N - 1,N - 1)]
  }
}

LoadBalancer {
}
