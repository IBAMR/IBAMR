// One ghost layer less than the minimum ghost width of an odd-width kernel must be rejected.
worst_case_ghost_width = TRUE
worst_case_kernel_width = 3
remove_ghost_layer = TRUE
Main {
 log_file_name = "output"
 log_all_nodes = FALSE
}
CartesianGeometry {
 domain_boxes = [(0,0), (15,7)]
 x_lo = 0,0
 x_up = 1,1
 periodic_dimension = 0,0
}
GriddingAlgorithm {
 max_levels = 1
 largest_patch_size { level_0 = 8,8 }
 smallest_patch_size { level_0 = 8,8 }
}
StandardTagAndInitialize {
 tagging_method = "REFINE_BOXES"
 RefineBoxes { }
}
LoadBalancer { }
