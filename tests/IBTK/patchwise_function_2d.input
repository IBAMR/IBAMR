Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [(-4,-6), (3,1)]
   x_lo = -2, -3
   x_up = 2, 5
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = 4, 4
   }
   smallest_patch_size {
      level_0 = 4, 4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(-2,-4), (1,-1)]
   }
}

LoadBalancer {
}
