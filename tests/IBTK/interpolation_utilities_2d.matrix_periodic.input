matrix_assembly = TRUE
periodic_matrix = TRUE
Main {
 log_file_name = "output"
 log_all_nodes = FALSE
}
CartesianGeometry {
 domain_boxes = [(0,0), (3,3)]
 x_lo = 0,0
 x_up = 1,1
 periodic_dimension = 1,1
}
GriddingAlgorithm {
 max_levels = 1
 largest_patch_size { level_0 = 4,4 }
 smallest_patch_size { level_0 = 4,4 }
}
StandardTagAndInitialize {
 tagging_method = "REFINE_BOXES"
 RefineBoxes { }
}
LoadBalancer { }
