// one level of patches exactly as wide as the ghost width, so that a side on the outermost layer of a ghost region is
// owned by two patches, periodic in x

var_type = "SIDE"
ghost_width = 3
depth = 2

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   timer_enabled = TRUE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (17,17)]
   x_lo               = 0, 0
   x_up               = 1, 1
   periodic_dimension = 1, 0
}

GriddingAlgorithm {
   max_levels = 1
   ratio_to_coarser    {level_1 = 2, 2}
   largest_patch_size  {level_0 = 3, 3}
   smallest_patch_size {level_0 = 3, 3}
   allow_patches_smaller_than_ghostwidth = TRUE

   efficiency_tolerance = 0.70e0
   combine_efficiency   = 0.85e0
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
   }
}

LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}

BcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

BcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}
