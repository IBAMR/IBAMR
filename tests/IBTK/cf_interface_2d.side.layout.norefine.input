// Four fine patches: a continued interface, a patch two fine cells above another (beyond a ghost width 2), and a concave corner. Without a refine operator.
MAX_LEVELS = 2
N = 16
REF_RATIO = 2
CENTERING = "SIDE"
GHOST_WIDTH = 2
REFINE_OP = "NONE"
FINE_BOXES = [(8,8),(15,15)], [(16,8),(23,15)], [(16,16),(23,23)], [(8,18),(15,25)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 336
   coarse_fine_locations = 290
   ghost_sum = 830.20947265625
   ghost_sum_squares = 2558.8224440813
   ghost_max = 4.343017578125
   ghost_weighted_sum = 44140.230712891
}
