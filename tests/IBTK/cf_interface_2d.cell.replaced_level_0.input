// Level 0 is replaced after a cached fill of levels 1 and 2. The second fine level is one coarse cell inside the first, so its refine schedule also reads level 0.
REPLACE_LEVEL_0 = TRUE
MAX_LEVELS = 3
N = 16
REF_RATIO = 2
REF_RATIO_2 = 2
CENTERING = "CELL"
GHOST_WIDTH = 2
REFINE_OP = "CONSERVATIVE_LINEAR_REFINE"
FINE_BOXES = [(8,8),(23,23)]
FINE_BOXES_2 = [(20,20),(43,43)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
      level_2 = REF_RATIO_2,REF_RATIO_2
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}
