// A fine level of a patch that spans the periodic direction and a patch on top of it that reaches the periodic
// boundary on one side only, solved with hypre's PFMG starting from zero and the exact ghost values.
exact_solution = 2.0
error_tolerance = 1.0e-6
solver_db {
   solver_type = "PFMG"
   rel_residual_tol = 1.0e-10
   max_iterations = 100
   initial_guess_nonzero = FALSE
}
test {
   ghost_width = 1
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 16
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 0
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = N, N
      level_1 = 64, 64
   }
   smallest_patch_size {
      level_0 = 4, 4
      level_1 = 4, 4
   }
   efficiency_tolerance = 0.99
   combine_efficiency = 0.99
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0, 3), (15, 5)], [(0, 6), (5, 10)]
   }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
