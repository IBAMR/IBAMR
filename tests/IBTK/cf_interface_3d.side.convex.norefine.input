// Two fine patches that touch at a corner, so that each has a convex corner cell in the ghost region of the other. Without a refine operator.
MAX_LEVELS = 2
N = 16
REF_RATIO = 2
CENTERING = "SIDE"
GHOST_WIDTH = 1
REFINE_OP = "NONE"
FINE_BOXES = [(8,8,8),(15,15,15)], [(16,16,16),(23,23,23)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 0,0,0
   x_up               = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512,512
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0,0),(N - 1,N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 3108
   coarse_fine_locations = 2490
   ghost_sum = 8290.4033203125
   ghost_sum_squares = 29335.497480869
   ghost_max = 4.93896484375
   ghost_weighted_sum = 842872.31542969
}
