// The notch case of the three-rank input on one rank. Without the fix, the marker is sent to the upper arm, 7.5 cells
// from it, and Debug stops because the interpolation did not set its velocity.
test {
   timestep = TRUE
   collective_print = TRUE
   num_timesteps = 1
   dt = 1.0
   kernel = "PIECEWISE_LINEAR"

   level_0_boxes = [(10,0),(19,4)], [(4,0),(9,4)], [(0,0),(3,4)], [(0,5),(3,9)]
   level_0_ranks = 0, 0, 0, 0

   u {
      function_0 = "0.0"
      function_1 = "0.12"
   }
   positions = 0.115, 0.99
   velocities = 0.0, 0.24

   UBcCoefs_0 {
      acoef_function_0 = "1.0"
      acoef_function_1 = "1.0"
      acoef_function_2 = "1.0"
      acoef_function_3 = "1.0"

      bcoef_function_0 = "0.0"
      bcoef_function_1 = "0.0"
      bcoef_function_2 = "0.0"
      bcoef_function_3 = "0.0"

      gcoef_function_0 = "0.0"
      gcoef_function_1 = "0.0"
      gcoef_function_2 = "0.0"
      gcoef_function_3 = "0.0"
   }

   UBcCoefs_1 {
      acoef_function_0 = "1.0"
      acoef_function_1 = "1.0"
      acoef_function_2 = "1.0"
      acoef_function_3 = "1.0"

      bcoef_function_0 = "0.0"
      bcoef_function_1 = "0.0"
      bcoef_function_2 = "0.0"
      bcoef_function_3 = "0.0"

      gcoef_function_0 = "0.12"
      gcoef_function_1 = "0.12"
      gcoef_function_2 = "0.12"
      gcoef_function_3 = "0.12"
   }
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
   timer_enabled = TRUE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (19,4)], [(0,5), (3,9)]
   x_lo               = 0, 0
   x_up               = 0.2, 2.0
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = 1
   ratio_to_coarser {
      level_1 = 2, 2
   }

   largest_patch_size {
      level_0 = 20, 10
   }

   smallest_patch_size {
      level_0 = 4, 4
   }

   efficiency_tolerance = 0.70e0
   combine_efficiency   = 0.85e0
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0,0),(0,0)]
   }
}

LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}

TimerManager{
   print_exclusive = FALSE
   print_total = TRUE
   print_threshold = 1.0
   timer_list = "IBTK::*::*"
}
