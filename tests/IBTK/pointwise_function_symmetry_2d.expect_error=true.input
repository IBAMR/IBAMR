// A pointwise function returns a nonsymmetric tensor for data with symmetric
// tensor storage on a uniform grid.

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (15,15)]
   x_lo               = -2, -3
   x_up               = 2, 5
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 8, 8
   }
   smallest_patch_size {
      level_0 = 4, 4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
   }
}

LoadBalancer {
}
