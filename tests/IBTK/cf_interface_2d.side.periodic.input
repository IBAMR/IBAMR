// Three fine patches on a domain periodic in x and y. Two form one band across the periodic boundary in x, so the
// coarse-fine interfaces above and below the band cross it. The third touches both periodic boundaries.
MAX_LEVELS = 2
N = 16
REF_RATIO = 2
CENTERING = "SIDE"
GHOST_WIDTH = 2
REFINE_OP = "CONSERVATIVE_LINEAR_REFINE"
FINE_BOXES = [(0,8),(7,15)], [(24,8),(31,15)], [(0,24),(7,31)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 1,1
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 210
   coarse_fine_locations = 170
   ghost_sum = 236.16748046875
   ghost_sum_squares = 328.51941263676
   ghost_max = 1.464599609375
   ghost_weighted_sum = 10211.068847656
}
