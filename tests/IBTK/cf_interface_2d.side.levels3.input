// Three levels with refinement ratio 2 and ghost width 2, the second fine level one coarse cell inside the first, with the quadratic values in both ghost layers of the finest level.
MAX_LEVELS = 3
N = 16
REF_RATIO = 2,2
REF_RATIO_2 = 2,2
CENTERING = "SIDE"
GHOST_WIDTH = 2
REFINE_OP = "CONSERVATIVE_LINEAR_REFINE"
FINE_BOXES = [(8,8),(23,23)]
FINE_BOXES_2 = [(18,18),(31,45)], [(32,18),(45,45)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = 2,2
      level_2 = 2,2
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 488
   coarse_fine_locations = 456
   ghost_sum = 1287.4438476562
   ghost_sum_squares = 3844.4519801438
   ghost_max = 4.0620727539062
   ghost_weighted_sum = 131942.99377441
}
