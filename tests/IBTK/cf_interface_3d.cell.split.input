// The fine level is split into patches of at most 8 cells per side, so that several patches touch the coarse-fine
// interface.
MAX_LEVELS = 2
N = 8
REF_RATIO = 2
GHOST_WIDTH = 2
CENTERING = "CELL"

Main {
// log file parameters
   log_file_name = "output"
   log_all_nodes = FALSE

   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 0, 0, 0  // lower end of computational domain.
   x_up               = 1, 1, 1  // upper end of computational domain.
   periodic_dimension = 0, 0, 0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 8, 8, 8
   }

   smallest_patch_size {
      level_0 =   4,   4, 4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [( N/2,0,0 ),( N - 1,N - 1, N - 1)]
  }
}

LoadBalancer {
}
