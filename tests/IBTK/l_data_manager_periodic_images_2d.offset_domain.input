Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

N = 16

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = -8.0, -8.0
   x_up = 8.0, 8.0
   periodic_dimension = 1, 1
}

GriddingAlgorithm {
   max_levels = 1

   ratio_to_coarser {
      level_1 = 2, 2
   }

   largest_patch_size {
      level_0 = 8, 8
   }

   smallest_patch_size {
      level_0 = 8, 8
   }

   efficiency_tolerance = 0.70e0
   combine_efficiency = 0.85e0
}

LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
