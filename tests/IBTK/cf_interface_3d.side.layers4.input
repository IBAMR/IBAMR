// Three fine patches in an L shape, ratio 4, ghost width 3, with the quadratic values in all three ghost layers.
MAX_LEVELS = 2
N = 16
REF_RATIO = 4
CENTERING = "SIDE"
GHOST_WIDTH = 3
REFINE_OP = "CONSERVATIVE_LINEAR_REFINE"
FINE_BOXES = [(16,16,16),(31,31,31)], [(32,16,16),(47,31,31)], [(32,32,16),(47,47,31)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 0,0,0
   x_up               = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512,512
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0,0),(N - 1,N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 42612
   coarse_fine_locations = 32775
   ghost_sum = 101365.06921387
   ghost_sum_squares = 325050.66502963
   ghost_max = 4.4593505859375
   ghost_weighted_sum = 17323747.739624
}
