// An L-shaped domain of two boxes. One fine patch crosses the faces that the boxes share, so the coarse-fine ghost
// faces beside it include shared faces.
MAX_LEVELS = 2
N = 16
REF_RATIO = 2
CENTERING = "SIDE"
GHOST_WIDTH = 2
REFINE_OP = "CONSERVATIVE_LINEAR_REFINE"
FINE_BOXES = [(4,12),(9,19)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,7)], [(0,8), (7,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 152
   coarse_fine_locations = 120
   ghost_sum = 258.310546875
   ghost_sum_squares = 570.15039968491
   ghost_max = 2.749267578125
   ghost_weighted_sum = 10480.970214844
}
