// Three levels with different refinement ratios along the axes and ghost width 2, the second fine level one coarse cell inside the first, with no refine operator, so that the fill sets only the coarse-fine ghost cells.
MAX_LEVELS = 3
N = 16
REF_RATIO = 2,4
REF_RATIO_2 = 2,2
CENTERING = "SIDE"
GHOST_WIDTH = 2
REFINE_OP = "NONE"
FINE_BOXES = [(8,16),(23,47)]
FINE_BOXES_2 = [(18,34),(31,93)], [(32,34),(45,93)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = 2,4
      level_2 = 2,2
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 744
   coarse_fine_locations = 712
   ghost_sum = 2011.8770141602
   ghost_sum_squares = 6022.5605944553
   ghost_max = 4.1244049072266
   ghost_weighted_sum = 341871.63977051
}
