// Three levels with refinement ratios 4 and 2 and ghost width 2, the second fine level one coarse cell inside the first: the finest level has the ratio 2 to the next coarser level and 8 to level 0, with no refine operator, so that the fill sets only the coarse-fine ghost cells.
MAX_LEVELS = 3
N = 8
REF_RATIO = 4,4,4
REF_RATIO_2 = 2,2,2
CENTERING = "SIDE"
GHOST_WIDTH = 2
REFINE_OP = "NONE"
FINE_BOXES = [(8,8,8),(23,23,23)]
FINE_BOXES_2 = [(18,18,18),(31,45,45)], [(32,18,18),(45,45,45)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 0,0,0
   x_up               = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = 4,4,4
      level_2 = 2,2,2
   }
   largest_patch_size {
      level_0 = 512,512,512
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0,0),(N - 1,N - 1,N - 1)]
  }
}

LoadBalancer {
}
