// Side-centered data whose ghost values are also refined from the coarser level.
MAX_LEVELS = 2
N = 8
REF_RATIO = 2
CENTERING = "SIDE"
REFINE_TYPE = "CONSERVATIVE_LINEAR_REFINE"   // refine operator used when filling ghost values

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0, 0
   x_up               = 1, 1
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512, 512
   }

   smallest_patch_size {
      level_0 =   4,   4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [( N/2,0 ),( N - 1,N - 1)]
  }
}

LoadBalancer {
}
