error_case = "null_variable"
N = 8*2

Main {
// log file parameters
   log_file_name = "output"
   log_all_nodes = FALSE

}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = -2, -3  // lower end of computational domain.
   x_up               = 2, 5  // upper end of computational domain.
   periodic_dimension = 0, 0
}

GriddingAlgorithm {
   max_levels = 1

   ratio_to_coarser {
      level_1 = 2,2
   }
   largest_patch_size {
      level_0 = 8, 8
   }

   smallest_patch_size {
      level_0 =   4,   4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
     level_0 = [( N/2, N/2 ),( 3*N/4, 3*N/4 )]
   }
}

LoadBalancer {
}
