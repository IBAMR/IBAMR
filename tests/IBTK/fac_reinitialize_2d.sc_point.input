// An L-shaped fine level that touches the physical boundary, with the SC point relaxation FAC operator and a PETSc
// coarse level solver. The second problem has a Neumann condition at the lower y face for the first velocity component.
test {
   operator_class = "SCPoissonPointRelaxationFACOperator"
   ghost_width = 1
   neumann_face = 2
   neumann_object = 0
}
operator_db {
   coarse_solver_type = "PETSC_LEVEL_SOLVER"
}
preconditioner_db {
   cycle_type = "V_CYCLE"
   num_pre_sweeps = 1
   num_post_sweeps = 1
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 16
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 0, 0
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = N, N
      level_1 = 64, 64
   }
   smallest_patch_size {
      level_0 = 4, 4
      level_1 = 4, 4
   }
   efficiency_tolerance = 0.99
   combine_efficiency = 0.99
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0, 0), (5, 9)], [(6, 0), (9, 5)]
   }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
