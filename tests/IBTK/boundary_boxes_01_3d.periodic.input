// 8 fine patches, periodic in x and y, with a gap at the upper boundary in every direction and patches touching the lower z boundary.
GHOST_WIDTH = 4
REF_RATIO = 2

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [(0,0,0), (9,9,9)]
   x_lo = 0, 0, 0
   x_up = 1, 1, 1
   periodic_dimension = 1, 1, 0
}

Level0 {
   lower = 0, 0, 0
   size = 5, 5, 5
   gap = 0, 0, 0
   number = 2, 2, 2
}

Level1 {
   lower = 0, 0, 0
   size = 8, 8, 8
   gap = 2, 2, 2
   number = 2, 2, 2
}
