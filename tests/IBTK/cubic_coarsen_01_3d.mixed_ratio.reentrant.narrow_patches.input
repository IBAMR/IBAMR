// The mixed_ratio.reentrant case on fine patches two cells wide along the axes with ratio 2
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}
// The coarse cells along the reentrant edge
corner_cells = 7,4,7, 8,11,8
function_names = "smooth", "cubic"
smooth_sc {
   function_0 = "sin(2*PI*(X_0+0.13))*cos(2*PI*(X_1+0.31))*sin(2*PI*(X_2+0.07))"
   function_1 = "cos(2*PI*(X_0+0.21))*sin(2*PI*(X_1+0.17))*cos(2*PI*(X_2+0.11))"
   function_2 = "sin(2*PI*(X_0+0.05))*cos(2*PI*(X_1+0.27))*cos(2*PI*(X_2+0.19))"
}
smooth_cc {
   function = "sin(2*PI*(X_0+0.13))*cos(2*PI*(X_1+0.31))*sin(2*PI*(X_2+0.07))"
}

cubic_sc {
   function_0 = "1 + 0.3*X_0 - 0.5*X_1 + 0.4*X_2 + X_0^3 - 2*X_0^2*X_1 + 0.7*X_1^3 + X_0*X_1*X_2 + 0.6*X_2^3"
   function_1 = "2 - 0.4*X_0 + 0.2*X_1 + 0.5*X_2 + 0.7*X_0^2*X_1 - 0.8*X_0*X_1^2 + 1.1*X_1^3 - X_2^3 + X_0*X_2^2"
   function_2 = "0.5 + 0.1*X_0 - 0.6*X_1 + 0.9*X_2 + 0.4*X_0^3 + 0.3*X_0*X_1*X_2 + 0.6*X_1^2*X_2 - 1.2*X_2^3"
}
cubic_cc {
   function = "1 + 0.3*X_0 - 0.5*X_1 + 0.4*X_2 + X_0^3 - 2*X_0^2*X_1 + 0.7*X_1^3 + X_0*X_1*X_2 + 0.6*X_2^3"
}

CartesianGeometry {
   domain_boxes = [(0,0,0), (15,15,15)]
   x_lo = 0,0,0
   x_up = 1,1,1
   periodic_dimension = 0,0,0
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2,4,2
   }
   largest_patch_size {
      level_0 = 2,16,2
   }
   smallest_patch_size {
      level_0 = 2,2,2
   }
   efficiency_tolerance = 0.99e0
   combine_efficiency = 0.99e0
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(4,4,4), (7,11,7)], [(4,4,8), (7,11,11)], [(8,4,4), (11,11,7)]
   }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
