// Use N divisible by four.
// Increase N while retaining the same physical refinement regions.
N = 128

run_discrete_test = FALSE

solver_type = "SCALED_PETSC_KRYLOV_SOLVER"
precond_type = "SCALED_POINT_RELAXATION_FAC_PRECONDITIONER"

// Manufactured equation:
//
//     C*u + S*div(D*grad(u)) = f
//
//     u = exp(x+y)
//     C = 1 + 0.1*(x+y)
//     S = 0.5 + 0.25*(x*x+y*y)
//     D = -kappa
//     kappa = 1 + 0.2*(x+y)
//
//     div(kappa*grad(u)) = 2*(kappa+0.2)*u

C
{
   function = "1.0 + 0.1*(X_0+X_1)"
}

S
{
   function = "0.5 + 0.25*(X_0^2+X_1^2)"
}

D
{
   function = "-(1.0 + 0.2*(X_0+X_1))"
}

u_exact
{
   function = "exp(X_0+X_1)"
}

f
{
   function = "((1.0+0.1*(X_0+X_1))-2.0*(0.5+0.25*(X_0^2+X_1^2))*(1.2+0.2*(X_0+X_1)))*exp(X_0+X_1)"
}

KrylovSolver
{
   ksp_type = "fgmres"

   initial_guess_nonzero = FALSE
   rel_residual_tol = 1.0e-11
   abs_residual_tol = 1.0e-12
   max_iterations = 500
   enable_logging = TRUE

}

FAC
{
   cycle_type = "V_CYCLE"

   coarse_solver_prefix = "coarse_"

   num_pre_sweeps = 1
   num_post_sweeps = 2

   smoother_type = "RED_BLACK_GAUSS_SEIDEL"

   prolongation_method = "LINEAR_REFINE"
   restriction_method = "CONSERVATIVE_COARSEN"

   coarse_solver_type = "SCALED_PETSC_LEVEL_SOLVER"
   coarse_solver_rel_residual_tol = 1.0e-4
   coarse_solver_abs_residual_tol = 1.0e-13
   coarse_solver_max_iterations = 100

   coarse_solver_db
   {
      ksp_type = "gmres"
      pc_type = "jacobi"
      enable_logging = FALSE
   }

}

BoundaryConditions
{
   // u + 0.5*du/dn = g.
   // Lower faces: du/dn = -u.
   // Upper faces: du/dn = +u.

   acoef_function_0 = "1.0"
   bcoef_function_0 = "0.5"
   gcoef_function_0 = "0.5*exp(X_0+X_1)"

   acoef_function_1 = "1.0"
   bcoef_function_1 = "0.5"
   gcoef_function_1 = "1.5*exp(X_0+X_1)"

   acoef_function_2 = "1.0"
   bcoef_function_2 = "0.5"
   gcoef_function_2 = "0.5*exp(X_0+X_1)"

   acoef_function_3 = "1.0"
   bcoef_function_3 = "0.5"
   gcoef_function_3 = "1.5*exp(X_0+X_1)"
}

Main
{
   log_file_name = "CCScaledPoissonFAC2d.log"
   log_all_nodes = FALSE
   timer_enabled = TRUE

   viz_writer = "VisIt"
   viz_dump_dirname = "viz_scaled_poisson_fac"
   visit_number_procs_per_file = 1
}

CartesianGeometry
{
   domain_boxes = [(0,0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 0, 0
}

GriddingAlgorithm
{
   max_levels = 3

   ratio_to_coarser
   {
      level_1 = 2, 2
      level_2 = 2, 2
   }

   largest_patch_size
   {
      level_0 = 16, 16
   }

   smallest_patch_size
   {
      level_0 = 4, 4
   }

   efficiency_tolerance = 0.70
   combine_efficiency = 0.85
}

StandardTagAndInitialize
{
   tagging_method = "REFINE_BOXES"

   RefineBoxes
   {
      // Indices belong to the level being tagged.
      level_0 = [(N/4, N/4), (3*N/4 - 1, 3*N/4 - 1)]
      level_1 = [(3*N/4, 3*N/4), (5*N/4 - 1, 5*N/4 - 1)]
   }
}

LoadBalancer
{
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1.0
}

TimerManager
{
   print_exclusive = FALSE
   print_total = TRUE
   print_threshold = 1.0
   timer_list = "IBTK::*::*"
}
