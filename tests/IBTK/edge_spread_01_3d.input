// One patch of 16 by 16 by 16 cells and 64 points in its interior.

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

N = 16
num_points = 64

CartesianGeometry {
   domain_boxes = [ (0,0,0),(N - 1,N - 1,N - 1) ]
   x_lo = 0.0, 0.0, 0.0
   x_up = 1.0, 1.0, 1.0
   periodic_dimension = 0, 0, 0
}
