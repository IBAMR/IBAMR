// A periodic level with four patches. Neither solver sets initial_guess_nonzero.
exact_solution = 2.0
error_tolerance = 1.0e-6
solver_db {
   ksp_type = "gmres"
   pc_type = "jacobi"
   rel_residual_tol = 1.0e-12
   max_iterations = 1000
}
one_iteration_solver_db {
   ksp_type = "richardson"
   pc_type = "none"
   max_iterations = 1
}
test {
   ghost_width = 1
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 16
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 1
}
GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = N / 2, N / 2
   }
   smallest_patch_size {
      level_0 = 4, 4
   }
   efficiency_tolerance = 0.99
   combine_efficiency = 0.99
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0, 0), (1, 1)]
   }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
