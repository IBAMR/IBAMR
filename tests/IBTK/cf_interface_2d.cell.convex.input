// Two fine patches that touch at a corner, so that each has a convex corner cell in the ghost region of the other.
MAX_LEVELS = 2
N = 16
REF_RATIO = 2
CENTERING = "CELL"
GHOST_WIDTH = 1
REFINE_OP = "CONSERVATIVE_LINEAR_REFINE"
FINE_BOXES = [(8,8),(15,15)], [(16,16),(23,23)]

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes       = [(0,0), (N - 1,N - 1)]
   x_lo               = 0,0
   x_up               = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
  tagging_method = "REFINE_BOXES"
  RefineBoxes {
    level_0 = [(0,0),(N - 1,N - 1)]
  }
}

LoadBalancer {
}

Reference {
   ghost_locations = 68
   coarse_fine_locations = 62
   ghost_sum = 158.5927734375
   ghost_sum_squares = 428.1415553093
   ghost_max = 3.62548828125
   ghost_weighted_sum = 8070.1567382812
}
