// TRACTION at x = 0, x = 1, z = 0, and z = 1, velocity prescribed at y = 0 and y = 1.
// The viscosity is 1 + x / 2 + y / 4 + z / 8 + 0.3 sin(3 x + 2 y + z). The traction data are the product of the
// viscosity and the stress. The ghost width of the velocity is 3. The fill therefore uses the viscosity at edges up to
// 3 cells beyond a patch.

N = 8
variable_viscosity = TRUE
extension_ghost_width = 3

ExactVelocity {
   max_error_over_h_squared = 8.0
   function_0 = "(0.3)+(0.5)*X_0+(0.2)*X_1+(-0.4)*X_2"
   function_1 = "(-0.2)+(0.3)*X_0+(-0.7)*X_1+(0.1)*X_2"
   function_2 = "(0.1)+(0.25)*X_0+(-0.15)*X_1+(0.2)*X_2"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "0.0"
   acoef_function_5 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "1.0"
   bcoef_function_5 = "1.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "(0.3)+(0.5)*X_0+(0.2)*X_1+(-0.4)*X_2"
   gcoef_function_3 = "(0.3)+(0.5)*X_0+(0.2)*X_1+(-0.4)*X_2"
   gcoef_function_4 = "(-0.15)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
   gcoef_function_5 = "(-0.15)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "0.0"
   acoef_function_5 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "1.0"
   bcoef_function_5 = "1.0"

   gcoef_function_0 = "(0.5)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
   gcoef_function_1 = "(0.5)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
   gcoef_function_2 = "(-0.2)+(0.3)*X_0+(-0.7)*X_1+(0.1)*X_2"
   gcoef_function_3 = "(-0.2)+(0.3)*X_0+(-0.7)*X_1+(0.1)*X_2"
   gcoef_function_4 = "(-0.05)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
   gcoef_function_5 = "(-0.05)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
}

VelocityBcCoefs_2 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "0.0"
   acoef_function_5 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "1.0"
   bcoef_function_5 = "1.0"

   gcoef_function_0 = "(-0.15)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
   gcoef_function_1 = "(-0.15)*(1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2))"
   gcoef_function_2 = "(0.1)+(0.25)*X_0+(-0.15)*X_1+(0.2)*X_2"
   gcoef_function_3 = "(0.1)+(0.25)*X_0+(-0.15)*X_1+(0.2)*X_2"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "0.0"
}

ViscosityFunction {
   function = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
}

ViscosityBoundaryConditions {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "1.0"
   acoef_function_5 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "0.0"
   bcoef_function_5 = "0.0"

   gcoef_function_0 = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
   gcoef_function_1 = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
   gcoef_function_2 = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
   gcoef_function_3 = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
   gcoef_function_4 = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
   gcoef_function_5 = "1.0+0.5*X_0+0.25*X_1+0.125*X_2+0.3*sin(3.0*X_0+2.0*X_1+X_2)"
}

INSVCStaggeredNonConservativeHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   mu_is_const             = FALSE
   rho_is_const            = TRUE
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
   velocity_solver_type    = "VC_VELOCITY_PETSC_KRYLOV_SOLVER"
   velocity_precond_type   = "VC_VELOCITY_POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_precond_db {
      coarse_solver_type = "VC_VELOCITY_PETSC_LEVEL_SOLVER"
   }
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0,0),(N - 1,N - 1,N - 1) ]
   x_lo = 0,0,0
   x_up = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 4,4,4
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {}
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
