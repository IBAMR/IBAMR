PETSC_OPTIONS_FILE = "stokes_petsc_level_solver_shell.opts"
test {
 f_data_type = "CELL"
 n_components = 1
 ghost_width = 1
 shell_pc_type = "multiplicative-eigen-schur-complement"
 shell_pc_subdomain_traversal = "SYMMETRIC"
 lifetime = TRUE
 box_size = 2
 eigen_subdomain_solver_type = "JACOBI_SVD"
 eigen_subdomain_pseudoinverse_type = "JACOBI_SVD"
 a00_solver_type = "FULL_PIV_LU"
 schur_solver_type = "JACOBI_SVD"
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 4
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 1
}
GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = N/2, N/2
   }
   smallest_patch_size {
      level_0 = N/2, N/2
   }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(0, 0), (N - 1, N - 1)]
   }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
