// Partition independence: PSEUDO_TRACTION conditions on the lower boundaries, walls on the upper boundaries.
// The kernel is IB_4. The markers are shifted by 0.0, 0.9 cells. The grid has 16 x 16 cells.
N = 16
MAX_LEVELS = 1
marker_shift = 0.0, 0.9

Reference {
   markers           = 128
   ghost_faces       = 468
   ghost_sum         = 73.45035277867
   ghost_sum_squares = 242.47306833406
   ghost_max         = 1.5312068355514
   F_dot_Ju          = -2.592539017622
   Ju_sum_squares    = 93.159631267835
   Ju_max            = 1.0907862106609
   SF_sum            = -26.32300101753
   SF_sum_squares    = 147210.32204884
   SF_max            = 140.9503919434
   SF_dot_u          = -663.68998851123
   N_sum             = 294.27909563706
   N_sum_squares     = 6382.5362280605
   N_max             = 20.066556233704
}

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time     = 0.0
   end_time       = 0.01
   dt_max         = 0.01
   enable_logging = FALSE
}

IBMethod {
   delta_fcn      = "IB_4"
   enable_logging = FALSE
}

IBRedundantInitializer {
   max_levels       = MAX_LEVELS
   base_filenames_0 = "markers"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "PSEUDO_TRACTION"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 16,16
   }
   smallest_patch_size {
      level_0 = 16,16
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
