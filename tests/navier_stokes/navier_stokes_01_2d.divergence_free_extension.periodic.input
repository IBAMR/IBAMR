// Extend a velocity into the ghost cells outside the domain with a divergence-free extension
// and check its divergence, its consistency between patches, its adjoint, and its accuracy for
// a smooth divergence-free velocity whose boundary data match it, on a level of 4-cell patches in a
// domain that is periodic in x, with a TRACTION condition at y = 0 and a wall at y = 1, with
// LINEAR_EXTRAPOLATION corners. The velocity is periodic in x.
check_divergence_free_extension = TRUE

N = 16
extension_ghost_width = 3

ExactVelocity {
   function_0 = "sin(2*_pi*X_0)*(0.3+1.0*X_1-1.2*X_1^2)"
   function_1 = "-2*_pi*cos(2*_pi*X_0)*(0.3*X_1+0.5*X_1^2-0.4*X_1^3)"
}

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
}

PressureInitialConditions {
   function = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "sin(2*_pi*X_0)*(0.3+1.0*X_1-1.2*X_1^2)"
   gcoef_function_1 = "sin(2*_pi*X_0)*(0.3+1.0*X_1-1.2*X_1^2)"
   gcoef_function_2 = "sin(2*_pi*X_0)*(1.0-2.4*X_1)+4*_pi^2*sin(2*_pi*X_0)*(0.3*X_1+0.5*X_1^2-0.4*X_1^3)"
   gcoef_function_3 = "sin(2*_pi*X_0)*(0.3+1.0*X_1-1.2*X_1^2)"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "-2*_pi*cos(2*_pi*X_0)*(0.3*X_1+0.5*X_1^2-0.4*X_1^3)"
   gcoef_function_1 = "-2*_pi*cos(2*_pi*X_0)*(0.3*X_1+0.5*X_1^2-0.4*X_1^3)"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "-2*_pi*cos(2*_pi*X_0)*(0.3*X_1+0.5*X_1^2-0.4*X_1^3)"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   traction_bc_corner_type = "LINEAR_EXTRAPOLATION"
   convective_op_type      = "PPM"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 1,0
}

GriddingAlgorithm {
   max_levels = 1
   ratio_to_coarser {
      level_1 = 2,2
   }
   largest_patch_size {
      level_0 = 4,4
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {}
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
