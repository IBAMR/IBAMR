// As in mixed, but the boundary y = 1 prescribes the velocity until t = 0.5 and the TRACTION afterward. A fill
// at t = 0 or t = 1, after any earlier fills and checkBoundaryConditionTypes(), must equal that of a new operator.

N = 16
extension_ghost_width = 3

TypeChange {
   t1 = 0.0
   t2 = 1.0
}

ExactVelocity {
   function_0 = "(0.2)+(0.7)*X_0+(-0.6)*X_1"
   function_1 = "(-0.1)+(-0.8)*X_0+(-0.7)*X_1"
}

VelocityBcCoefs_0 {
   t_switch = 0.5

   acoef_function_0 = "1.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "t < t_switch ? 1.0 : 0.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "t < t_switch ? 0.0 : 1.0"

   gcoef_function_0 = "(0.2)+(0.7)*X_0+(-0.6)*X_1"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "(-1.4)"
   gcoef_function_3 = "t < t_switch ? (0.2)+(0.7)*X_0+(-0.6)*X_1 : (-1.4)"
}

VelocityBcCoefs_1 {
   t_switch = 0.5

   acoef_function_0 = "1.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "t < t_switch ? 1.0 : 0.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "t < t_switch ? 0.0 : 1.0"

   gcoef_function_0 = "(-0.1)+(-0.8)*X_0+(-0.7)*X_1"
   gcoef_function_1 = "(-1.4)"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "t < t_switch ? (-0.1)+(-0.8)*X_0+(-0.7)*X_1 : 0.0"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   convective_op_type      = "PPM"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 2.0,1.0
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 4,4
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {}
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
