// TRACTION boundaries all around and a smooth divergence-free velocity, on a grid of 16 by 16 cells.

N = 16

ExactVelocity {
   error_bound = 3.0e-2
   stress_error_bound = 1.0
   function_0 = "1.0+1.7*sin(1.3*X_0+0.2)*cos(1.7*X_1+0.4)+0.4*X_0*X_0"
   function_1 = "1.0-1.3*cos(1.3*X_0+0.2)*sin(1.7*X_1+0.4)-0.8*X_0*X_1"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "-1.2*sin(1.3*X_0+0.2)*sin(1.7*X_1+0.4)-0.8*X_1"
   gcoef_function_3 = "-1.2*sin(1.3*X_0+0.2)*sin(1.7*X_1+0.4)-0.8*X_1"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "-1.2*sin(1.3*X_0+0.2)*sin(1.7*X_1+0.4)-0.8*X_1"
   gcoef_function_1 = "-1.2*sin(1.3*X_0+0.2)*sin(1.7*X_1+0.4)-0.8*X_1"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 8,8
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
