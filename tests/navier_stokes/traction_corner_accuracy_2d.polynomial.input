// TRACTION boundaries all around and a divergence-free velocity that is quadratic along every boundary, for which the
// ghost values are exact. The patches are two cells wide, so the faces next to a corner lie in different patches.

N = 16

ExactVelocity {
   error_bound = 1.0e-12
   stress_error_bound = 1.0e-9
   function_0 = "1.0+X_1*X_1+2.0*X_0*X_1"
   function_1 = "1.0+X_0*X_0-X_1*X_1"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "4*X_0+2*X_1"
   gcoef_function_3 = "4*X_0+2*X_1"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "1.0"

   gcoef_function_0 = "4*X_0+2*X_1"
   gcoef_function_1 = "4*X_0+2*X_1"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 2,2
   }
   smallest_patch_size {
      level_0 = 2,2
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
