// Extend a velocity into the ghost cells outside the domain with a divergence-free extension
// and check its divergence, its consistency between patches, its adjoint, and its accuracy for
// a smooth divergence-free velocity whose boundary data match it, on a level of 4-cell patches with
// TRACTION conditions at x = 0, x = 1, z = 0 and z = 1, walls at y = 0 and y = 1, with LINEAR_EXTRAPOLATION corners.
check_divergence_free_extension = TRUE

N = 8
extension_ghost_width = 3

ExactVelocity {
   function_0 = "(0.3)+(0.15)*X_0^1*X_2^1+(0.7)*X_0^1*X_1^1+(-0.4)*X_0^2+(0.2)*X_0^2*X_1^1"
   function_1 = "(-0.2)+(0.45)*X_1^1*X_2^1+(-0.35)*X_1^2+(0.2)*X_0^1*X_1^1+(-0.2)*X_0^1*X_1^2"
   function_2 = "(0.1)+(-0.3)*X_2^2+(-0.25)*X_1^2+(0.6)*X_0^1*X_2^1"
}

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
   function_2 = "0.0"
}

PressureInitialConditions {
   function = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "0.0"
   acoef_function_5 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "1.0"
   bcoef_function_5 = "1.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "(0.3)+(0.15)*X_0^1*X_2^1+(0.7)*X_0^1*X_1^1+(-0.4)*X_0^2+(0.2)*X_0^2*X_1^1"
   gcoef_function_3 = "(0.3)+(0.15)*X_0^1*X_2^1+(0.7)*X_0^1*X_1^1+(-0.4)*X_0^2+(0.2)*X_0^2*X_1^1"
   gcoef_function_4 = "(0.6)*X_2^1+(0.15)*X_0^1"
   gcoef_function_5 = "(0.6)*X_2^1+(0.15)*X_0^1"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "0.0"
   acoef_function_5 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "1.0"
   bcoef_function_5 = "1.0"

   gcoef_function_0 = "(0.2)*X_1^1+(-0.2)*X_1^2+(0.7)*X_0^1+(0.2)*X_0^2"
   gcoef_function_1 = "(0.2)*X_1^1+(-0.2)*X_1^2+(0.7)*X_0^1+(0.2)*X_0^2"
   gcoef_function_2 = "(-0.2)+(0.45)*X_1^1*X_2^1+(-0.35)*X_1^2+(0.2)*X_0^1*X_1^1+(-0.2)*X_0^1*X_1^2"
   gcoef_function_3 = "(-0.2)+(0.45)*X_1^1*X_2^1+(-0.35)*X_1^2+(0.2)*X_0^1*X_1^1+(-0.2)*X_0^1*X_1^2"
   gcoef_function_4 = "(-0.05)*X_1^1"
   gcoef_function_5 = "(-0.05)*X_1^1"
}

VelocityBcCoefs_2 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = "0.0"
   acoef_function_5 = "0.0"

   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = "1.0"
   bcoef_function_5 = "1.0"

   gcoef_function_0 = "(0.6)*X_2^1+(0.15)*X_0^1"
   gcoef_function_1 = "(0.6)*X_2^1+(0.15)*X_0^1"
   gcoef_function_2 = "(0.1)+(-0.3)*X_2^2+(-0.25)*X_1^2+(0.6)*X_0^1*X_2^1"
   gcoef_function_3 = "(0.1)+(-0.3)*X_2^2+(-0.25)*X_1^2+(0.6)*X_0^1*X_2^1"
   gcoef_function_4 = "0.0"
   gcoef_function_5 = "0.0"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   traction_bc_corner_type = "LINEAR_EXTRAPOLATION"
   convective_op_type      = "PPM"
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0,0),(N - 1,N - 1,N - 1) ]
   x_lo = 0,0,0
   x_up = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = 1
   ratio_to_coarser {
      level_1 = 2,2,2
   }
   largest_patch_size {
      level_0 = 4,4,4
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {}
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
