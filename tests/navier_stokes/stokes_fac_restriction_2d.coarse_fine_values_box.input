// A fine level in an L shape with a reentrant corner.
f_u {
   function_0 = "1 + sin(2*PI*X_1)"
   function_1 = "2 + sin(2*PI*X_0)"
}
test {
   ghost_width = 1
   operator_type = "BOX"
   check_coarse_fine_ghost_values = TRUE
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 16
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 0, 0
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser { level_1 = 2, 2 }
   largest_patch_size {
      level_0 = N, N
      level_1 = N, N
   }
   smallest_patch_size {
      level_0 = N, N
      level_1 = 4, 4
   }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes { level_0 = [(4, 4), (7, 7)], [(8, 4), (11, 7)], [(8, 8), (11, 11)] }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
}
FACPreconditioner {
   U_restriction_method = "RT0_COARSEN"
}
