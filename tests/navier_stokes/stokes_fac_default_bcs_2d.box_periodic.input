// Box relaxation on a fully periodic domain, with a PETSc coarse level solver and no boundary helper.
solver_type = "BOX_RELAXATION_FAC_PRECONDITIONER"
f_u {
   function_0 = "1 + sin(2*PI*X_1)"
   function_1 = "2 + sin(2*PI*X_0)"
}
test { ghost_width = 1 }
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 8
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 1
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser { level_1 = 2, 2 }
   largest_patch_size {
      level_0 = N, N
      level_1 = N, N
   }
   smallest_patch_size {
      level_0 = N, N
      level_1 = N, N
   }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes { level_0 = [(0, 0), (N/2 - 1, N - 1)] }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
}
FACPreconditioner {
   coarse_solver_type = "PETSC_LEVEL_SOLVER"
}
