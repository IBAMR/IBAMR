// Partition independence: walls on all boundaries.
// The kernel is IB_4. The markers are shifted by 0.9, 0.9 cells. The grid has 16 x 16 cells in 4 patches of 8 x 8
// cells.
N = 16
MAX_LEVELS = 1
marker_shift = 0.9, 0.9

Reference {
   markers           = 128
   ghost_faces       = 468
   ghost_sum         = 7.3917613116613
   ghost_sum_squares = 268.68282227395
   ghost_max         = 1.9324261251006
   F_dot_Ju          = -2.2827330553255
   Ju_sum_squares    = 88.486017969444
   Ju_max            = 1.0910907677912
   SF_sum            = -196.44568652188
   SF_sum_squares    = 198723.78654458
   SF_max            = 131.84668565776
   SF_dot_u          = -584.37966216332
   N_sum             = 275.81605596828
   N_sum_squares     = 7741.9840339
   N_max             = 20.066556233704
}

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time     = 0.0
   end_time       = 0.01
   dt_max         = 0.01
   enable_logging = FALSE
}

IBMethod {
   delta_fcn      = "IB_4"
   enable_logging = FALSE
}

IBRedundantInitializer {
   max_levels       = MAX_LEVELS
   base_filenames_0 = "markers"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 8,8
   }
   smallest_patch_size {
      level_0 = 8,8
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
