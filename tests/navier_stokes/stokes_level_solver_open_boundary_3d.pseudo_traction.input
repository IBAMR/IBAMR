// PSEUDO_TRACTION conditions on the middle of each z boundary and prescribed velocity elsewhere.

N = 6

// The Robin coefficients are a = 1, b = 0, g = velocity where the velocity is prescribed and
// a = 0, b = 1, g = traction where the traction is prescribed.
TRACTION_PART = "((X_0 > 0.2) && (X_0 < 0.8) && (X_1 > 0.2) && (X_1 < 0.8))"
U = "sin(2*X_0)*cos(X_1)*cos(X_2)"
V = "cos(X_0)*sin(2*X_1)*cos(X_2)"
W = "cos(X_0)*cos(X_1)*sin(2*X_2)"
T_N = "cos(3*X_0)+X_1+X_2"
T_0 = "0.3*cos(2*X_0)"
T_1 = "0.2*sin(X_1)"

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = TRACTION_PART + " ? 0.0 : 1.0"
   acoef_function_5 = TRACTION_PART + " ? 0.0 : 1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = TRACTION_PART + " ? 1.0 : 0.0"
   bcoef_function_5 = TRACTION_PART + " ? 1.0 : 0.0"

   gcoef_function_0 = U
   gcoef_function_1 = U
   gcoef_function_2 = U
   gcoef_function_3 = U
   gcoef_function_4 = TRACTION_PART + " ? (" + T_0 + ") : (" + U + ")"
   gcoef_function_5 = TRACTION_PART + " ? (" + T_0 + ") : (" + U + ")"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = TRACTION_PART + " ? 0.0 : 1.0"
   acoef_function_5 = TRACTION_PART + " ? 0.0 : 1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = TRACTION_PART + " ? 1.0 : 0.0"
   bcoef_function_5 = TRACTION_PART + " ? 1.0 : 0.0"

   gcoef_function_0 = V
   gcoef_function_1 = V
   gcoef_function_2 = V
   gcoef_function_3 = V
   gcoef_function_4 = TRACTION_PART + " ? (" + T_1 + ") : (" + V + ")"
   gcoef_function_5 = TRACTION_PART + " ? (" + T_1 + ") : (" + V + ")"
}

VelocityBcCoefs_2 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"
   acoef_function_4 = TRACTION_PART + " ? 0.0 : 1.0"
   acoef_function_5 = TRACTION_PART + " ? 0.0 : 1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"
   bcoef_function_4 = TRACTION_PART + " ? 1.0 : 0.0"
   bcoef_function_5 = TRACTION_PART + " ? 1.0 : 0.0"

   gcoef_function_0 = W
   gcoef_function_1 = W
   gcoef_function_2 = W
   gcoef_function_3 = W
   gcoef_function_4 = TRACTION_PART + " ? (" + T_N + ") : (" + W + ")"
   gcoef_function_5 = TRACTION_PART + " ? (" + T_N + ") : (" + W + ")"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0e-2
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "PSEUDO_TRACTION"
   enable_logging          = FALSE
}

level_solver_db {
   ksp_type = "preonly"
   pc_type = "svd"
   initial_guess_nonzero = FALSE
   max_iterations = 1
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0,0),(N - 1,N - 1,N - 1) ]
   x_lo = 0,0,0
   x_up = 1,1,1
   periodic_dimension = 0,0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 512,512,512
   }
   smallest_patch_size {
      level_0 = 4,4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
