// Fully refined periodic FAC restriction with prescribed fine ghost values.
C = 2.0
D = -0.01
N = 4
u {
   function_0 = "1 + sin(2*PI*X_1)"
   function_1 = "2 + sin(2*PI*X_0)"
}
p { function = "0.0" }
f_u {
   function_0 = "2 + (2 + 0.04*PI*PI)*sin(2*PI*X_1)"
   function_1 = "4 + (2 + 0.04*PI*PI)*sin(2*PI*X_0)"
}
f_p { function = "0.0" }
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 1, 1
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser { level_1 = 2, 2 }
   largest_patch_size {
      level_0 = N, N
      level_1 = 2*N, 2*N
   }
   smallest_patch_size {
      level_0 = N, N
      level_1 = 2*N, 2*N
   }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes { level_0 = [(0, 0), (N - 1, N - 1)] }
}
LoadBalancer { bin_pack_method = "SPATIAL" }
FACPreconditioner {
   num_pre_sweeps = 1
   num_post_sweeps = 1
   U_prolongation_method = "RT0_REFINE"
   U_restriction_method = "RT0_COARSEN"
   P_prolongation_method = "CONSTANT_REFINE"
   P_restriction_method = "CONSERVATIVE_COARSEN"
   level_solver_type = "PETSC_LEVEL_SOLVER"
   level_solver_max_iterations = 1
   level_solver_db {
      ksp_type = "gmres"
      pc_type = "none"
   }
   coarse_solver_type = "PETSC_LEVEL_SOLVER"
   coarse_solver_max_iterations = 100
   coarse_solver_rel_residual_tol = 1.0e-12
   coarse_solver_abs_residual_tol = 1.0e-14
   coarse_solver_db {
      ksp_type = "gmres"
      pc_type = "none"
   }
}
