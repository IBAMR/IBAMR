// TRACTION conditions on the middle half of each y boundary and prescribed velocity elsewhere, in
// creeping flow.

// physical parameters
MU  = 1.0e-2                              // fluid viscosity
RHO = 1.0                                 // fluid density
L   = 1.0

// grid spacing parameters
MAX_LEVELS = 1                            // maximum number of levels in locally refined grid
N = 16                                    // number of grid cells in each direction

// solver parameters
SOLVER_TYPE        = "STAGGERED"          // the fluid solver to use (STAGGERED or COLLOCATED)
CFL_MAX            = 0.3                  // maximum CFL number
DT_MAX             = 0.0625/N             // maximum timestep size
START_TIME         = 0.0e0                // initial simulation time
END_TIME           = 0.03125              // final simulation time
GROW_DT            = 2.0e0                // growth factor for timesteps
NUM_CYCLES         = 1                    // number of cycles of fixed-point iteration
NORMALIZE_PRESSURE = FALSE                // the normal traction determines the pressure
REGRID_INTERVAL    = 10000000             // effectively disable regridding
ENABLE_LOGGING     = TRUE
TRACTION_BC_TYPE   = "TRACTION"

// exact solution function expressions
U = "1 - 2*(cos(2*PI*(X_0-t))*sin(2*PI*(X_1-t)))*exp(-8*PI*PI*nu*t)"
V = "1 + 2*(sin(2*PI*(X_0-t))*cos(2*PI*(X_1-t)))*exp(-8*PI*PI*nu*t)"
P = "-(cos(4*PI*(X_0-t)) + cos(4*PI*(X_1-t)))*exp(-16*PI*PI*nu*t)"

// tractions on the y boundaries: -p + 2*mu*dv/dy and mu*(du/dy + dv/dx), which vanishes for
// this solution; they are imposed where X_0 is in the middle half of the boundary
T_N = "(cos(4*PI*(X_0-t))+cos(4*PI*(X_1-t)))*exp(-16*PI^2*nu*t)-8*nu*sin(2*PI*(X_0-t))*PI*sin(2*PI*(X_1-t))*exp(-8*PI^2*nu*t)"
T_T = "0.0"
TRACTION_PART = "((X_0 > 0.25) && (X_0 < 0.75))"

// body force: minus the convective term of the exact solution, so that the exact solution also
// solves the Stokes problem (the rho*u.grad(u) term is dropped by creeping_flow)
ForcingFunction {
   nu = MU/RHO
   function_0 = "-((1 - 2*cos(2*PI*(X_0-t))*sin(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t))*(4*PI*sin(2*PI*(X_0-t))*sin(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t)) + (1 + 2*sin(2*PI*(X_0-t))*cos(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t))*(-4*PI*cos(2*PI*(X_0-t))*cos(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t)))"
   function_1 = "-((1 - 2*cos(2*PI*(X_0-t))*sin(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t))*(4*PI*cos(2*PI*(X_0-t))*cos(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t)) + (1 + 2*sin(2*PI*(X_0-t))*cos(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t))*(-4*PI*sin(2*PI*(X_0-t))*sin(2*PI*(X_1-t))*exp(-8*PI*PI*nu*t)))"
}

VelocityInitialConditions {
   nu = MU/RHO
   function_0 = U
   function_1 = V
}

// Velocity conditions on the x boundaries (locations 0 and 1) and, outside the middle half of
// the boundary, on the y boundaries (locations 2 and 3); traction conditions in the middle half
// of the y boundaries. The Robin coefficients a, b, g are a = 1, b = 0, g = velocity where the
// velocity is prescribed and a = 0, b = 1, g = traction where the traction is prescribed.
VelocityBcCoefs_0 {
   nu = MU/RHO

   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = TRACTION_PART + " ? 0.0 : 1.0"
   acoef_function_3 = TRACTION_PART + " ? 0.0 : 1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = TRACTION_PART + " ? 1.0 : 0.0"
   bcoef_function_3 = TRACTION_PART + " ? 1.0 : 0.0"

   gcoef_function_0 = U
   gcoef_function_1 = U
   gcoef_function_2 = TRACTION_PART + " ? (" + T_T + ") : (" + U + ")"
   gcoef_function_3 = TRACTION_PART + " ? (" + T_T + ") : (" + U + ")"
}

VelocityBcCoefs_1 {
   nu = MU/RHO

   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = TRACTION_PART + " ? 0.0 : 1.0"
   acoef_function_3 = TRACTION_PART + " ? 0.0 : 1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = TRACTION_PART + " ? 1.0 : 0.0"
   bcoef_function_3 = TRACTION_PART + " ? 1.0 : 0.0"

   gcoef_function_0 = V
   gcoef_function_1 = V
   gcoef_function_2 = TRACTION_PART + " ? (" + T_N + ") : (" + V + ")"
   gcoef_function_3 = TRACTION_PART + " ? (" + T_N + ") : (" + V + ")"
}

PressureInitialConditions {
   nu = MU/RHO
   function = P
}

INSStaggeredHierarchyIntegrator {
   creeping_flow                 = TRUE
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   num_cycles                    = NUM_CYCLES
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT_MAX
   regrid_interval               = REGRID_INTERVAL
   enable_logging                = ENABLE_LOGGING
   traction_bc_type              = TRACTION_BC_TYPE

   stokes_solver_type = "PETSC_KRYLOV_SOLVER"
   stokes_precond_type = "PROJECTION_PRECONDITIONER"
   stokes_solver_db {
      ksp_type = "fgmres"
      rel_residual_tol = 1.0e-12
      max_iterations = 200
   }
   stokes_precond_db {
      Phi_data_refine_type = "NONE"
      Phi_use_cf_interpolation = TRUE
      Phi_data_coarsen_type = "CUBIC_COARSEN"
      Phi_bdry_extrap_type = "LINEAR"
   }

   velocity_solver_type = "PETSC_KRYLOV_SOLVER"
   velocity_precond_type = "POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_solver_db {
      ksp_type = "richardson"
      max_iterations = 1
      laplace_op {
         data_refine_type = "NONE"
         use_cf_interpolation = TRUE
         data_coarsen_type = "CUBIC_COARSEN"
         bdry_extrap_type = "LINEAR"
      }
   }
   velocity_precond_db {
      num_pre_sweeps  = 0
      num_post_sweeps = 3
      prolongation_method = "CONSTANT_REFINE"
      restriction_method  = "CONSERVATIVE_COARSEN"
      coarse_solver_type  = "HYPRE_LEVEL_SOLVER"
      coarse_solver_rel_residual_tol = 1.0e-12
      coarse_solver_abs_residual_tol = 1.0e-50
      coarse_solver_max_iterations = 1
      coarse_solver_db {
         solver_type          = "Split"
         split_solver_type    = "PFMG"
         enable_logging       = FALSE
      }
      data_refine_type = "NONE"
      use_cf_interpolation = TRUE
      data_coarsen_type = "CUBIC_COARSEN"
      bdry_extrap_type = "LINEAR"
   }

   pressure_solver_type = "PETSC_KRYLOV_SOLVER"
   pressure_precond_type = "POINT_RELAXATION_FAC_PRECONDITIONER"
   pressure_solver_db {
      ksp_type = "richardson"
      max_iterations = 1
      laplace_op {
         data_refine_type = "NONE"
         use_cf_interpolation = TRUE
         data_coarsen_type = "CUBIC_COARSEN"
         bdry_extrap_type = "LINEAR"
      }
   }
   pressure_precond_db {
      num_pre_sweeps  = 0
      num_post_sweeps = 3
      prolongation_method = "LINEAR_REFINE"
      restriction_method  = "CONSERVATIVE_COARSEN"
      coarse_solver_type  = "HYPRE_LEVEL_SOLVER"
      coarse_solver_rel_residual_tol = 1.0e-12
      coarse_solver_abs_residual_tol = 1.0e-50
      coarse_solver_max_iterations = 1
      coarse_solver_db {
         solver_type          = "PFMG"
         num_pre_relax_steps  = 0
         num_post_relax_steps = 3
         enable_logging       = FALSE
      }
      data_refine_type = "NONE"
      use_cf_interpolation = TRUE
      data_coarsen_type = "CUBIC_COARSEN"
      bdry_extrap_type = "LINEAR"
   }

   regrid_projection_solver_type = "PETSC_KRYLOV_SOLVER"
   regrid_projection_precond_type = "POINT_RELAXATION_FAC_PRECONDITIONER"
   regrid_projection_solver_db {
      ksp_type = "fgmres"
   }
   regrid_projection_precond_db {
      num_pre_sweeps  = 0
      num_post_sweeps = 3
      prolongation_method = "LINEAR_REFINE"
      restriction_method  = "CONSERVATIVE_COARSEN"
      coarse_solver_type  = "HYPRE_LEVEL_SOLVER"
      coarse_solver_rel_residual_tol = 1.0e-12
      coarse_solver_abs_residual_tol = 1.0e-50
      coarse_solver_max_iterations = 1
      coarse_solver_db {
         solver_type          = "PFMG"
         num_pre_relax_steps  = 0
         num_post_relax_steps = 3
         enable_logging       = FALSE
      }
      data_refine_type = "NONE"
      use_cf_interpolation = TRUE
      data_coarsen_type = "CUBIC_COARSEN"
      bdry_extrap_type = "LINEAR"
   }
}

Main {
   solver_type = SOLVER_TYPE
   check_open_boundary_ghost_values = TRUE   // run the check instead of advancing in time
   log_file_name               = "output"
   log_all_nodes               = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = L,L
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 =   4,  4
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
