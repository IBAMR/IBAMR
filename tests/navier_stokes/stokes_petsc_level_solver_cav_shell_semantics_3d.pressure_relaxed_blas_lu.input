// This case checks pressure-cell-seeded CAV construction and forward
// multiplicative BLAS/LAPACK LU application across a 3D solver lifecycle.

test {
   f_data_type                             = "CELL"
   n_components                           = 1
   ghost_width                            = 1
   coupling_aware_asm_closure_policy      = "RELAXED"
   coupling_aware_asm_patch_seed_type     = "PRESSURE_CELL"
   coupling_aware_asm_seed_axis           = 0
   coupling_aware_asm_seed_stride         = 1
   coupling_aware_asm_seed_traversal_order = "I_J_K"
   shell_pc_type                          = "multiplicative-blas-lapack"
   blas_lapack_subdomain_solver_type      = "lu"
   shell_pc_relaxation_factor             = 1.0
   parity_tol                             = 1.0e-10
   require_parity                         = TRUE
   verify_reinitialize                    = TRUE
}

// A legal periodic 8^3 patch isolates the dimension-specialized shell path.
Main {
   log_file_name               = "output"
   log_all_nodes               = FALSE
   viz_writer                  = "VisIt"
   viz_dump_dirname            = "viz3d"
   visit_number_procs_per_file = 1
}

N = 8

CartesianGeometry {
   domain_boxes       = [(0, 0, 0), (N - 1, N - 1, N - 1)]
   x_lo               = 0.0, 0.0, 0.0
   x_up               = 1.0, 1.0, 1.0
   periodic_dimension = 1, 1, 1
}

GriddingAlgorithm {
   max_levels = 1

   largest_patch_size {
      level_0 = N, N, N
   }

   smallest_patch_size {
      level_0 = N, N, N
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"

   RefineBoxes {
      level_0 = [(0, 0, 0), (N - 1, N - 1, N - 1)]
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
