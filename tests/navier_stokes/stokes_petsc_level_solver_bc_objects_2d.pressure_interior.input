// Solve directly on a refined level in the interior of the domain, with a pressure that is not zero outside the level.
solver_db {
   ksp_type = "preonly"
   pc_type = "svd"
   initial_guess_nonzero = FALSE
   max_iterations = 1
}
INSStaggeredHierarchyIntegrator {
   mu = 1.0
   rho = 1.0
}
test {
   ghost_width = 1
   pressure_constant = 3.0
   pressure_gradient = 4.0, -1.0
}
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}
N = 8
CartesianGeometry {
   domain_boxes = [(0, 0), (N - 1, N - 1)]
   x_lo = 0.0, 0.0
   x_up = 1.0, 1.0
   periodic_dimension = 0, 0
}
GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = N, N
      level_1 = N, N
   }
   smallest_patch_size {
      level_0 = N, N
      level_1 = N, N
   }
}
StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(N / 4, N / 4), (3 * N / 4 - 1, 3 * N / 4 - 1)]
   }
}
LoadBalancer {
   bin_pack_method = "SPATIAL"
   max_workload_factor = 1
}
