// Velocity prescribed at x = 0 and y = 1, TRACTION at x = 2 and y = 0, in the domain [0,2] x [0,1].
// The viscosity is 1 + x / 2 + y / 4. The traction data are the product of the viscosity and the stress. The ghost
// width of the velocity is 1.

N = 16
variable_viscosity = TRUE
extension_ghost_width = 1

ExactVelocity {
   max_error_over_h_squared = 0.3
   function_0 = "(0.2)+(0.7)*X_0+(-0.6)*X_1"
   function_1 = "(-0.1)+(-0.8)*X_0+(-0.7)*X_1"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "(0.2)+(0.7)*X_0+(-0.6)*X_1"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "(-1.4)*(1.0+0.5*X_0+0.25*X_1)"
   gcoef_function_3 = "(0.2)+(0.7)*X_0+(-0.6)*X_1"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "(-0.1)+(-0.8)*X_0+(-0.7)*X_1"
   gcoef_function_1 = "(-1.4)*(1.0+0.5*X_0+0.25*X_1)"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "(-0.1)+(-0.8)*X_0+(-0.7)*X_1"
}

ViscosityFunction {
   function = "1.0+0.5*X_0+0.25*X_1"
}

ViscosityBoundaryConditions {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "1.0+0.5*X_0+0.25*X_1"
   gcoef_function_1 = "1.0+0.5*X_0+0.25*X_1"
   gcoef_function_2 = "1.0+0.5*X_0+0.25*X_1"
   gcoef_function_3 = "1.0+0.5*X_0+0.25*X_1"
}

INSVCStaggeredNonConservativeHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   mu_is_const             = FALSE
   rho_is_const            = TRUE
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   traction_bc_type        = "TRACTION"
   enable_logging          = FALSE
   velocity_solver_type    = "VC_VELOCITY_PETSC_KRYLOV_SOLVER"
   velocity_precond_type   = "VC_VELOCITY_POINT_RELAXATION_FAC_PRECONDITIONER"
   velocity_precond_db {
      coarse_solver_type = "VC_VELOCITY_PETSC_LEVEL_SOLVER"
   }
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(N - 1,N - 1) ]
   x_lo = 0,0
   x_up = 2.0,1.0
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = 1
   largest_patch_size {
      level_0 = 4,4
   }
   smallest_patch_size {
      level_0 = 4,4
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {}
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
