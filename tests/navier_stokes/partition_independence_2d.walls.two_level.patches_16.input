// Partition independence on two levels: walls on all boundaries.
// The kernel is IB_4. The markers are shifted by -0.9, -0.9 cells. The grid has 16 x 16 cells on level 0 and 64 x 64
// cells on level 1, where 16 patches cover the lower left quarter of the domain.
NC = 16
N = 64   // the marker spacing is a fraction of the finest grid spacing
MAX_LEVELS = 2
marker_region_upper = 0.45   // the markers lie in the refined region [0, 0.5]^2
marker_shift = -0.9, -0.9

Reference {
   markers           = 116
   ghost_faces       = 402
   ghost_sum         = 45.698268971077
   ghost_sum_squares = 209.65353108059
   ghost_max         = 1.2441276710424
   F_dot_Ju          = 0.079187673176951
   Ju_sum_squares    = 77.85308906359
   Ju_max            = 1.0511730201695
   SF_sum            = -2911.5369354757
   SF_sum_squares    = 44937530.700628
   SF_max            = 1505.5273098352
   SF_dot_u          = 324.3527093328
   N_sum             = 1323.0643502478
   N_sum_squares     = 146730.45598315
   N_max             = 68.432850770578
}

VelocityInitialConditions {
   function_0 = "0.0"
   function_1 = "0.0"
}

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time     = 0.0
   end_time       = 0.01
   dt_max         = 0.01
   enable_logging = FALSE
}

IBMethod {
   delta_fcn      = "IB_4"
   enable_logging = FALSE
}

IBRedundantInitializer {
   max_levels       = MAX_LEVELS
   base_filenames_0 = "markers"
}

INSStaggeredHierarchyIntegrator {
   mu                      = 1.0
   rho                     = 1.0
   start_time              = 0.0
   end_time                = 0.01
   dt_max                  = 0.01
   enable_logging          = FALSE
}

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [ (0,0),(NC - 1,NC - 1) ]
   x_lo = 0,0
   x_up = 1,1
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = 4,4
   }
   largest_patch_size {
      level_0 = 8,8
      level_1 = 8,8
   }
   smallest_patch_size {
      level_0 = 8,8
      level_1 = 8,8
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [ (0,0),(7,7) ]
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}
