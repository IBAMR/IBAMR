// Fine patch across the periodic boundaries; smooth field.
test_linear_fill = TRUE
smooth_field = TRUE

Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

N = 16

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 0, 0, 0
   x_up               = 1, 1, 1
   periodic_dimension = 1, 1, 1
}

GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 4, 4, 4
   }
   largest_patch_size {
      level_0 = 2^8, 2^8, 2^8
   }
   smallest_patch_size {
      level_0 = 1, 1, 1
   }
}

StandardTagAndInitialize {
   tagging_method = "REFINE_BOXES"
   RefineBoxes {
      level_0 = [(N/2,0,0), (N - 1,N/2 - 1,N/2 - 1)]
   }
}

LoadBalancer {}
