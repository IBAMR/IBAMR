// allow_patches_smaller_than_ghostwidth with a smallest patch size below the ghost width, and a largest patch size
// below the ghost width, which debug builds check.
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [(0,0), (31,31)]
   x_lo         = 0, 0
   x_up         = 1, 1
   periodic_dimension = 0, 0
}

ghost_width = 8

GriddingAlgorithm {
   max_levels = 2
   ratio_to_coarser {
      level_1 = 2, 2
   }
   largest_patch_size {
      level_0 = 6, 6
   }
   smallest_patch_size {
      level_0 = 4, 4
   }
   efficiency_tolerance = 0.85
   combine_efficiency   = 0.85
   allow_patches_smaller_than_ghostwidth = TRUE
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR", "REFINE_BOXES"
   RefineBoxes {
      level_0 {
         boxes_0 = [(14,14), (15,15)]
      }
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1.0
}
