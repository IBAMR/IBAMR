// Tags at opposite corners of a level whose index space has 2^32 cells, so the bounding box of the tags has more
// cells than an int holds. The level above them must cover only the tags.
Main {
   log_file_name = "output"
   log_all_nodes = FALSE
}

CartesianGeometry {
   domain_boxes = [(0,0), (63,63)]
   x_lo         = 0, 0
   x_up         = 1, 1
   periodic_dimension = 0, 0
}

ghost_width = 2

GriddingAlgorithm {
   max_levels = 3
   ratio_to_coarser {
      level_1 = 1024, 1024
      level_2 = 2, 2
   }
   largest_patch_size {
      level_0 = 4096, 4096
   }
   smallest_patch_size {
      level_0 = 4, 4
   }
   efficiency_tolerance = 0.85
   combine_efficiency   = 0.85
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR", "REFINE_BOXES"
   RefineBoxes {
      level_0 {
         boxes_0 = [(0,0), (0,0)], [(63,63), (63,63)]
      }
      level_1 {
         boxes_0 = [(0,0), (3,3)], [(65532,65532), (65535,65535)]
      }
   }
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1.0
}
