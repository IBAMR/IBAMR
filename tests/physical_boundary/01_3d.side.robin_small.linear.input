// Side-centered ghost fill with linear extrapolation and Robin coefficients a = b = 1.0e-14 on the domain [1,2]^3

N = 8

VAR_CENTERING = "SIDE"
EXTRAP_TYPE = "LINEAR"

Q = "X_0 + 2.0*X_1 + 3.0*X_2"

bc_coefs_0 {
    acoef_function_0 = "1.0e-14"
    acoef_function_1 = "1.0e-14"
    acoef_function_2 = "1.0e-14"
    acoef_function_3 = "1.0e-14"
    acoef_function_4 = "1.0e-14"
    acoef_function_5 = "1.0e-14"

    bcoef_function_0 = "1.0e-14"
    bcoef_function_1 = "1.0e-14"
    bcoef_function_2 = "1.0e-14"
    bcoef_function_3 = "1.0e-14"
    bcoef_function_4 = "1.0e-14"
    bcoef_function_5 = "1.0e-14"

    gcoef_function_0 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-1.0))"
    gcoef_function_1 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (1.0))"
    gcoef_function_2 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-2.0))"
    gcoef_function_3 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (2.0))"
    gcoef_function_4 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-3.0))"
    gcoef_function_5 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (3.0))"
}

bc_coefs_1 {
    acoef_function_0 = "1.0e-14"
    acoef_function_1 = "1.0e-14"
    acoef_function_2 = "1.0e-14"
    acoef_function_3 = "1.0e-14"
    acoef_function_4 = "1.0e-14"
    acoef_function_5 = "1.0e-14"

    bcoef_function_0 = "1.0e-14"
    bcoef_function_1 = "1.0e-14"
    bcoef_function_2 = "1.0e-14"
    bcoef_function_3 = "1.0e-14"
    bcoef_function_4 = "1.0e-14"
    bcoef_function_5 = "1.0e-14"

    gcoef_function_0 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-1.0))"
    gcoef_function_1 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (1.0))"
    gcoef_function_2 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-2.0))"
    gcoef_function_3 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (2.0))"
    gcoef_function_4 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-3.0))"
    gcoef_function_5 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (3.0))"
}

bc_coefs_2 {
    acoef_function_0 = "1.0e-14"
    acoef_function_1 = "1.0e-14"
    acoef_function_2 = "1.0e-14"
    acoef_function_3 = "1.0e-14"
    acoef_function_4 = "1.0e-14"
    acoef_function_5 = "1.0e-14"

    bcoef_function_0 = "1.0e-14"
    bcoef_function_1 = "1.0e-14"
    bcoef_function_2 = "1.0e-14"
    bcoef_function_3 = "1.0e-14"
    bcoef_function_4 = "1.0e-14"
    bcoef_function_5 = "1.0e-14"

    gcoef_function_0 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-1.0))"
    gcoef_function_1 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (1.0))"
    gcoef_function_2 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-2.0))"
    gcoef_function_3 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (2.0))"
    gcoef_function_4 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (-3.0))"
    gcoef_function_5 = "1.0e-14*(X_0 + 2.0*X_1 + 3.0*X_2 + (3.0))"
}


Main {
// log file parameters
   log_file_name = "output"
   log_all_nodes = FALSE

   viz_writer = "VisIt"
   viz_dump_dirname = "viz2d"
   visit_number_procs_per_file = 1
}

CartesianGeometry {
   domain_boxes       = [(0,0,0), (N - 1,N - 1,N - 1)]
   x_lo               = 1, 1, 1  // lower end of computational domain.
   x_up               = 2, 2, 2  // upper end of computational domain.
   periodic_dimension = 0, 0, 0
}

GriddingAlgorithm {
   max_levels = 1

   largest_patch_size {
      level_0 = 512, 512, 512
   }

   smallest_patch_size {
      level_0 = 4, 4, 4
   }
}

StandardTagAndInitialize {
    tagging_method = "REFINE_BOXES"
    RefineBoxes {}
}

LoadBalancer {
}
