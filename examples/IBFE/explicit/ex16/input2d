// Physical parameters (CGS units, Vadala-Roth et al. 2020, Sec. 4.1)
MU       = 0.01
RHO      = 1.0
L        = 40.0
G_S      = 80.194
ETA      = 4.0097
TRACTION = 200.0

// Grid spacing parameters (m = 153 solid nodes at N = 32, MFAC = 1.0)
MAX_LEVELS = 1
REF_RATIO  = 2
N          = 32
DX         = L / N
MFAC       = 1.0
ELEM_TYPE  = "QUAD4"

// Volumetric stabilization parameters
STRESS_FORMULATION       = "MODIFIED_INVARIANTS"
NU_STAB                  = 0.4
VOLUMETRIC_MODE          = "PK1_PENALTY"
PRESSURE_PROJECTION_TYPE = "STABILIZED_PROJECTION"
STATIC_PRESSURE_KAPPA    = 2.0 * G_S * (1.0 + NU_STAB) / (3.0 * (1.0 - 2.0 * NU_STAB))
STATIC_PRESSURE_STAB     = 0.1
PK1_DEV_QUAD_ORDER       = "THIRD"
PK1_DIL_QUAD_ORDER       = "FIRST"

// Solver parameters (steady state uses LOAD_TIME = 100.0, END_TIME = 500.0)
DT         = 0.0025
KAPPA_D    = 2.5 * RHO * DX / (DT * DT)
START_TIME = 0.0
LOAD_TIME  = 1.0
END_TIME   = 2.0

VelocityBcCoefs_0 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {
   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "1.0"

   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "0.0"

   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

IBHierarchyIntegrator {
   start_time                = START_TIME
   end_time                  = END_TIME
   grow_dt                   = 2.0e0
   num_cycles                = 1
   regrid_fluid_cfl_interval = 0.5
   dt_max                    = DT
   error_on_dt_change        = TRUE
   enable_logging            = FALSE
}

IBFEMethod {
   IB_delta_fcn               = "IB_4"
   split_forces               = FALSE
   use_jump_conditions        = FALSE
   use_consistent_mass_matrix = TRUE
   IB_point_density           = 2.0
   static_pressure_kappa      = STATIC_PRESSURE_KAPPA
   static_pressure_stab_param = STATIC_PRESSURE_STAB
   enable_logging             = FALSE
}

INSStaggeredHierarchyIntegrator {
   mu                         = MU
   rho                        = RHO
   start_time                 = START_TIME
   end_time                   = END_TIME
   grow_dt                    = 2.0e0
   convective_op_type         = "PPM"
   convective_difference_form = "ADVECTIVE"
   normalize_pressure         = TRUE
   dt_max                     = DT
   using_vorticity_tagging    = FALSE
   enable_logging             = FALSE
}

Main {
   solver_type                 = "STAGGERED"
   log_file_name               = "IB2d.log"
   log_all_nodes               = FALSE
   viz_writer                  = "VisIt"
   viz_dump_interval           = 0
   viz_dump_dirname            = "viz_IB2d"
   visit_number_procs_per_file = 1
   restart_dump_interval       = 0
   restart_dump_dirname        = "restart_IB2d"
   data_dump_interval          = 0
   data_dump_dirname           = "hier_data_IB2d"
   timer_dump_interval         = 0
}

CartesianGeometry {
   domain_boxes       = [ (0,0),(N - 1,N - 1) ]
   x_lo               = 0.0,0.0
   x_up               = L,L
   periodic_dimension = 0,0
}

GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 512,512
   }
   smallest_patch_size {
      level_0 = 8,8
   }
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}

TimerManager {
   print_exclusive = FALSE
   print_total     = TRUE
   print_threshold = 0.1
   timer_list      = "IBAMR::*::*","IBTK::*::*","*::*::*"
}
