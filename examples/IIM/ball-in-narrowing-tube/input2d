// physical parameters
// INPUT FILE FOR THE TUBE WITH BLOCKAGE TO TEST NEAR CONTACT
PI_CONST = 3.14159265358979323
MU  = 0.05
RHO = 1.0
L   = 4.0 * PI_CONST
H = 2.0 * PI_CONST
// grid spacing parameters
MAX_LEVELS = 1                                     // maximum number of levels in locally refined grid
REF_RATIO  = 2                                      // refinement ratio between levels
N = 64               //LENGTHWISE                  // actual    number of grid cells on coarsest grid level
N_h = 32              //HEIGHTWISE
NFINEST = (REF_RATIO^(MAX_LEVELS - 1))*N            // effective number of grid cells on finest   grid level
DX0 = H/N                                           // mesh width on coarsest grid level
DX  = H/NFINEST                                     // mesh width on finest   grid level
MFAC = 2.0                                          // ratio of Lagrangian mesh width to Cartesian mesh width
ELEM_TYPE = "TRI3"                                  // type of element to use for structure discretization
PK1_DEV_QUAD_ORDER = "THIRD"
PK1_DIL_QUAD_ORDER = "FIRST"

P_E = 1.2
// model parameters
U_MAX = 2.0
C1_S = 0.1
P0_S = C1_S
BETA_S = 1.0*(NFINEST/64.0)



STRESS_FUNCTION = "MODIFIED"
USE_VOLUMETRIC_TERM = TRUE
YOUNGS_MOD     = 1e3//250
TRACTION_FORCE = 6.25
SHEAR_MOD      = 4.0 //1.0e2 //YOUNGS_MOD / 2.0 / (.5 + 1.0)
POISSON_RATIO  = 0.499
BULK_MOD 	   = 2.0 * SHEAR_MOD * (1.0 + POISSON_RATIO) / (3.0 - 6.0 * POISSON_RATIO)
SAFETY         = 0.5

// solver parameters
IB_DELTA_FUNCTION          = "IB_3"                 // the type of smoothed delta function to use for Lagrangian-Eulerian interaction
SPLIT_FORCES               = FALSE                  // whether to split interior and boundary forces
USE_PRESSURE_JUMP_CONDITIONS        = TRUE           // whether to impose pressure jumps at fluid-structure interfaces
USE_VELOCITY_JUMP_CONDITIONS        = TRUE           // whether to impose pressure jumps at fluid-structure interfaces
COMPUTE_FLUID_TRACTION = TRUE
WSS_CALC_WIDTH =1.05
P_CALC_WIDTH=1.3
USE_CONSISTENT_MASS_MATRIX = TRUE                   // whether to use a consistent or lumped mass matrix
IB_POINT_DENSITY           = 3.0                    // approximate density of IB quadrature points for Lagrangian-Eulerian interaction
SOLVER_TYPE                = "STAGGERED"            // the fluid solver to use (STAGGERED or COLLOCATED)
CFL_MAX                    = 0.25                   // maximum CFL number
DT                         = 2e-5 //0.05*DX //0.25*CFL_MAX*DX/U_MAX  // maximum timestep size
START_TIME                 = 0.0e0                  // initial simulation time
END_TIME                   = 2.6                   // final simulation time
GROW_DT                    = 2.0e0                  // growth factor for timesteps
NUM_CYCLES                 = 1                      // number of cycles of fixed-point iteration
CONVECTIVE_TS_TYPE         = "ADAMS_BASHFORTH"      // convective time stepping type
CONVECTIVE_OP_TYPE         = "PPM"                  // convective differencing discretization type
CONVECTIVE_FORM            = "ADVECTIVE"            // how to compute the convective terms
NORMALIZE_PRESSURE         = FALSE                  // whether to explicitly force the pressure to have mean zero
ERROR_ON_DT_CHANGE         = TRUE                  // whether to emit an error message if the time step size changes
VORTICITY_TAGGING          = TRUE                   // whether to tag cells for refinement based on vorticity thresholds
TAG_BUFFER                 = 1                      // size of tag buffer used by grid generation algorithm
REGRID_CFL_INTERVAL        = 0.5                    // regrid whenever any material point could have moved 0.5 meshwidths since previous regrid
OUTPUT_U                   = TRUE
OUTPUT_P                   = TRUE
OUTPUT_F                   = TRUE
OUTPUT_OMEGA               = TRUE
OUTPUT_DIV_U               = TRUE
ENABLE_LOGGING             = TRUE


NCYCLE = 5
KAPPA_S = 1e4 //0.0001/DT^2// 0.001 * DX/DT^2  //0.01 * DX/DT^2 //5e2
ETA_S =  0.0 //0.0005/DT //0.005/DT //0.05 * DX/DT

//KAPPA_PLATE = 7e2

SIM_NUM = 9

//Michael Facci additions
LOWER_PLATE_HEIGHT = -9.0 * PI_CONST*PI_CONST / 40.0  - PI_CONST/192
UPPER_PLATE_HEIGHT = 9.0 * PI_CONST*PI_CONST / 40.0  + PI_CONST/192
D = UPPER_PLATE_HEIGHT - LOWER_PLATE_HEIGHT
BALL_COM_X = -1.7//-PI_CONST
BALL_COM_Y = -0.5
BALL_RADIUS =  1.1   //9.0 * PI_CONST*PI_CONST / 40.0 //
KAPPA_STATIONARY = 1e4


//BOTTOM_PLANE_HEIGHT = 0.2
USE_SECOND_VELOCITY_CORRECTION = FALSE
USE_CURR_MESH_CONFIG = TRUE
//USE_PHONG_NORMALS = FALSE
USE_DISCON_ELEMS = FALSE
EPSILON = 0.0
LEFT_END          = -L/2 + EPSILON   //left endpoint of plate
RIGHT_END         =  L/2 - EPSILON  //right endpoint of plate

USE_RECTANGULAR_BLOCKAGE = FALSE

// Geometry Narrowing Parameters
// MIN_GAP sets the width at x=0
// NARROWING_WIDTH sets how long the "hill" is
MIN_GAP = 2.0           
NARROWING_WIDTH = 4.0

EXTERIOR_CALC_COEF = 0
//RADIUS = 0.1
//COM_X = L/2
//COM_Y = 0.5
//USE_GMSH_INPUT = FALSE
//MESH_NAME = "better_ellipse.msh"


X1_lower = LOWER_PLATE_HEIGHT
X1_upper = UPPER_PLATE_HEIGHT

// collocated solver parameters
PROJECTION_METHOD_TYPE = "PRESSURE_UPDATE"
SECOND_ORDER_PRESSURE_UPDATE = TRUE


THETA=0
U = "( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT ? (X1 - UPPER_PLATE_HEIGHT)*(X1 - LOWER_PLATE_HEIGHT) / (LOWER_PLATE_HEIGHT*UPPER_PLATE_HEIGHT) : 0.0 )"
V = "0.0"
W = "0.0"
P = " sqrt((X1 - 0.5*H)*(X1 - 0.5*H))  > D/2  ? 0.0 : (-2.0*p_e*(X0)/(L) + p_e)"




VelocityBcCoefs_0 {
       p_e = P_E
    D = D
    L = L

    mu = MU
    H = H
    U_MAX = U_MAX
   DX = DX
   U=U
   UPPER_PLATE_HEIGHT = UPPER_PLATE_HEIGHT
   LOWER_PLATE_HEIGHT = LOWER_PLATE_HEIGHT
    acoef_function_0 = "1.0"//"( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT - 2*DX ? 0.0 : 1.0 )"
    acoef_function_1 = "0.0"//"( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT ? 0.0 : 1.0 )"
    acoef_function_2 = "0.0"
    acoef_function_3 = "0.0"

    bcoef_function_0 = "0.0"//"( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT - 2*DX ? 1.0 : 0.0 )"
    bcoef_function_1 = "1.0"//"( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT  ? 1.0 : 0.0 )"
    bcoef_function_2 = "1.0"
    bcoef_function_3 = "1.0"

    gcoef_function_0 = U //"( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT ? 1.0 : 0.0 )"
    gcoef_function_1 = "0.0"//"( sqrt((X1)*(X1) ) < UPPER_PLATE_HEIGHT ? 1.0 : 0.0 )"
    gcoef_function_2 = "0.0"
    gcoef_function_3 = "0.0"
}

VelocityBcCoefs_1 {

    p_e = P_E
    D = D
    L = L
    X1_lower = X1_lower 
    X1_upper = X1_upper
    mu = MU
    H = H

   acoef_function_0 = "1.0"
   acoef_function_1 = "1.0"
   acoef_function_2 = "0.0"
   acoef_function_3 = "0.0"

   
   bcoef_function_0 = "0.0"
   bcoef_function_1 = "0.0"
   bcoef_function_2 = "1.0"
   bcoef_function_3 = "1.0"


   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"
}

VelocityInitialConditions{
   UPPER_PLATE_HEIGHT = UPPER_PLATE_HEIGHT
   LOWER_PLATE_HEIGHT = LOWER_PLATE_HEIGHT
   U=U
   function_0 = U
   function_1 = "0.0"
}

IBHierarchyIntegrator {
   start_time          = START_TIME
   end_time            = END_TIME
   grow_dt             = GROW_DT
   num_cycles          = NUM_CYCLES
   regrid_cfl_interval = REGRID_CFL_INTERVAL
   dt_max              = DT
   error_on_dt_change  = ERROR_ON_DT_CHANGE
   enable_logging      = ENABLE_LOGGING
