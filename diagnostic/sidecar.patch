+// Disposable diagnostic, restricted to the logged PETSc 3.23/3.24 configurations.
+#if !defined(PETSC_USE_LOG) || !PETSC_VERSION_GE(3, 20, 0)
+#error This diagnostic requires the approved logging-enabled PETSc configuration.
+#endif
+std::ofstream diagnostic_stream;
+std::set<PetscObject> diagnostic_matrices;
+const char* diagnostic_phase = nullptr;
+int diagnostic_cycle = -1, diagnostic_state = -1, diagnostic_evaluation = 0;
+
+PetscErrorCode
+diagnostic_ignore_event(PetscLogEvent, int, PetscObject, PetscObject, PetscObject, PetscObject)
+{
+    return 0;
+}
+PetscErrorCode
+diagnostic_object_create(PetscObject object)
+{
+    PetscClassId id;
+    const auto ierr = PetscObjectGetClassId(object, &id);
+    if (ierr) return ierr;
+    if (id == MAT_CLASSID) diagnostic_matrices.insert(object);
+    return 0;
+}
+PetscErrorCode
+diagnostic_object_destroy(PetscObject object)
+{
+    diagnostic_matrices.erase(object);
+    return 0;
+}
+struct DiagnosticObserver
+{
+    PetscLogHandler handler = nullptr;
+    DiagnosticObserver()
+    {
+        diagnostic_stream.open("numerical-sidecar.txt");
+        if (!diagnostic_stream) TBOX_ERROR("Cannot open numerical diagnostic sidecar\n");
+        diagnostic_stream << std::scientific << std::setprecision(17);
+        PetscErrorCode ierr = PetscLogHandlerCreateLegacy(PETSC_COMM_WORLD,
+                                                          diagnostic_ignore_event,
+                                                          diagnostic_ignore_event,
+                                                          diagnostic_object_create,
+                                                          diagnostic_object_destroy,
+                                                          &handler);
+        IBTK_CHKERRQ(ierr);
+        ierr = PetscLogHandlerStart(handler);
+        IBTK_CHKERRQ(ierr);
+    }
+    ~DiagnosticObserver()
+    {
+        PetscErrorCode ierr = PetscLogHandlerStop(handler);
+        IBTK_CHKERRQ(ierr);
+        ierr = PetscLogHandlerDestroy(&handler);
+        IBTK_CHKERRQ(ierr);
+        diagnostic_stream.close();
+    }
+};
 
+// Record interior operands, not ghosts, with stable geometry/component labels.
+// The four selected fixtures are serial; no MPI gather or numerical operation is added.
+void
+diagnostic_values(const char* label, HierarchyVector& x)
+{
+    diagnostic_stream << "vector " << label << " cycle=" << diagnostic_cycle << " state=" << diagnostic_state
+                      << " phase=" << (diagnostic_phase ? diagnostic_phase : "action")
+                      << " evaluation=" << diagnostic_evaluation << '\n';
+    const auto hierarchy = x.getPatchHierarchy();
+    for (int ln = x.getCoarsestLevelNumber(); ln <= x.getFinestLevelNumber(); ++ln)
+    {
+        Pointer<PatchLevel<NDIM>> level = hierarchy->getPatchLevel(ln);
+        for (PatchLevel<NDIM>::Iterator p(level); p; p++)
+        {
+            Pointer<Patch<NDIM>> patch = level->getPatch(p());
+            for (int c = 0; c < x.getNumberOfComponents(); ++c)
+            {
+                const int idx = x.getComponentDescriptorIndex(c);
+                Pointer<SideData<NDIM, double>> side = patch->getPatchData(idx);
+                Pointer<CellData<NDIM, double>> cell = patch->getPatchData(idx);
+                if (side)
+                    for (int axis = 0; axis < NDIM; ++axis)
+                    {
+                        const Box<NDIM> box = SideGeometry<NDIM>::toSideBox(patch->getBox(), axis);
+                        for (Box<NDIM>::Iterator b(box); b; b++)
+                            diagnostic_stream << ln << ' ' << p() << ' ' << c << ' ' << axis << ' ' << b() << ' '
+                                              << (*side)(SideIndex<NDIM>(b(), axis, SideIndex<NDIM>::Lower)) << '\n';
+                    }
+                else if (cell)
+                    for (Box<NDIM>::Iterator b(patch->getBox()); b; b++)
+                        diagnostic_stream << ln << ' ' << p() << ' ' << c << " -1 " << b() << ' ' << (*cell)(b())
+                                          << '\n';
+            }
+        }
+    }
+}
+
+void
+diagnostic_report_mffd(const char* prefix, HierarchyVector& base, HierarchyVector& direction)
+{
+    const double base_norm = NormOps::L2Norm(&base), direction_norm = NormOps::L2Norm(&direction);
+    diagnostic_stream << "mffd_norms prefix=" << prefix << " cycle=" << diagnostic_cycle
+                      << " state=" << diagnostic_state << " base=" << base_norm << " direction=" << direction_norm
+                      << " samrai_base=" << base.L2Norm() << " samrai_direction=" << direction.L2Norm()
+                      << " default_expected_h="
+                      << PETSC_SQRT_MACHINE_EPSILON * std::sqrt(1.0 + base_norm) / direction_norm << '\n';
+    int found = 0;
+    for (PetscObject object : diagnostic_matrices)
+    {
+        PetscBool match;
+        PetscErrorCode ierr = PetscObjectTypeCompare(object, MATMFFD, &match);
+        IBTK_CHKERRQ(ierr);
+        if (!match) continue;
+        const char* actual_prefix = nullptr;
+        ierr = PetscObjectGetOptionsPrefix(object, &actual_prefix);
+        IBTK_CHKERRQ(ierr);
+        if (std::string(actual_prefix ? actual_prefix : "") != prefix) continue;
+        ++found;
+        PetscScalar h;
+        ierr = MatMFFDGetH(reinterpret_cast<Mat>(object), &h);
+        IBTK_CHKERRQ(ierr);
+        diagnostic_stream << "live_mffd prefix=" << prefix << " h=" << h << '\n';
+        PetscViewer viewer = nullptr;
+        ierr = PetscViewerCreate(PETSC_COMM_WORLD, &viewer);
+        IBTK_CHKERRQ(ierr);
+        ierr = PetscViewerSetType(viewer, PETSCVIEWERASCII);
+        IBTK_CHKERRQ(ierr);
+        ierr = PetscViewerFileSetMode(viewer, FILE_MODE_APPEND);
+        IBTK_CHKERRQ(ierr);
+        ierr = PetscViewerFileSetName(viewer, "mffd-view.txt");
+        IBTK_CHKERRQ(ierr);
+        ierr = MatView(reinterpret_cast<Mat>(object), viewer);
+        IBTK_CHKERRQ(ierr);
+        ierr = PetscViewerDestroy(&viewer);
+        IBTK_CHKERRQ(ierr);
+    }
+    if (found != 1) TBOX_ERROR("Diagnostic did not observe exactly one matching live MFFD matrix\n");
+    diagnostic_values("direction", direction);
+}
